# Built app — distributed as a release asset, not tracked.
# The path is the CURRENT bundle name: this rule kept naming
# MortalShell2MacFix.app after the rename, so the built bundle -- including
# third-party codec payloads that must not live in the repository -- was
# silently tracked from the rename commit onward.
app/MacGameVideoFix.app/
app/MortalShell2MacFix.app/
# The second app's bundle, for the same reason: it is built from files
# already tracked in runtime/, so a copy of it in here is a second copy
# that can go stale without anything noticing.
app-padfix/MacGamePadFix.app/
*.zip
.DS_Store

# Proxy build output — runtime/libogg_64.dll is the tracked, shipped copy
runtime/build/
diagnostics/build/
__pycache__/
build/
