+}
+
+/* MGVF mgvf-0035: the lights a user chose, sent again.
+ *
+ * mgvf-0034 opens the pad shared, and macOS then repaints its lightbar
+ * whenever the front application changes: measured on 2026-09-15, 0.54 s
+ * after mgvf-0031 had rewritten Steam's colour at a game's start, and nobody
+ * wrote lights again for 16 minutes, so the user saw macOS's colour and not
+ * theirs. Nothing on this side can see macOS's writes, so the lights are
+ * re-asserted instead: once a packet carrying them has gone to the pad, a
+ * lights-only packet of ours goes whenever DUALSENSE_LIGHTS_REASSERT_MS pass
+ * with none.
+ *
+ * Called from process_hid_report under ext->cs, which the client write paths
+ * hold too, so this never interleaves with a client's packet; the pad's own
+ * input, about 65 reports a second on Bluetooth, is the clock, and a pad that
+ * sends nothing is not written to. Not before the first packet carrying the
+ * lights, which keeps mgvf-0031's rule that a title nobody writes lights for
+ * gets no packet of ours, and keeps the release ahead of any colour. A packet
+ * that fails is not retried sooner: the next attempt is the next interval. */
+static void dualsense_lights_reassert(DEVICE_OBJECT *device)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    BYTE buffer[DUALSENSE_BT_REPORT_LEN];
+    HID_XFER_PACKET out = {.reportBuffer = buffer};
+    IO_STATUS_BLOCK io = {0};
+    DWORD sent = (DWORD)ext->dualsense_lights_sent;
+
+    if (!sent || (DWORD)(GetTickCount() - sent) < DUALSENSE_LIGHTS_REASSERT_MS) return;
+    InterlockedExchange(&ext->dualsense_lights_sent, (LONG)(GetTickCount() | 1));
+
+    if (ext->report_fixups & HIDRAW_FIXUP_DUALSENSE_USB)
+    {
+        /* the emulated route: a 0x02 of a DualSense's 48 bytes, which the
+         * translation turns into a signed 0x31 with the next sequence */
+        out.reportId = DUALSENSE_USB_OUTPUT_ID;
+        if (!(out.reportBufferLen = dualsense_usb_lights_report(buffer, sizeof(buffer), &ext->dualsense_lights, 48)))
+            return;
+        dualsense_usb_set_output_report(device, &out, &io);
+    }
+    else
+    {
+        out.reportId = DUALSENSE_BT_REPORT_ID;
+        if (!(out.reportBufferLen = dualsense_bt_lights_report(buffer, sizeof(buffer), &ext->dualsense_lights,
+                                                               dualsense_crc32)))
+            return;
+        unix_device_set_output_report(device, &out, &io);
+    }
+    TRACE("device %p: set the lights again (packet of ours, Bluetooth) -- lightbar %s%02x%02x%02x, player %s%#x,"
+          " status %#lx\n", device, ext->dualsense_lights.bar ? "" : "as the client asks, not ",
+          ext->dualsense_lights.rgb[0], ext->dualsense_lights.rgb[1], ext->dualsense_lights.rgb[2],
+          ext->dualsense_lights.player ? "" : "as the client asks, not ", ext->dualsense_lights.pattern, io.Status);
+    if (io.Status)
+        WARN("device %p: the lights could not be set again, status %#lx -- tried again in %u ms\n",
+             device, io.Status, DUALSENSE_LIGHTS_REASSERT_MS);
 }
 
