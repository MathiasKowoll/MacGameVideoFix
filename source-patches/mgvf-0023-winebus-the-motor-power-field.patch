@@ -1973,10 +1975,18 @@
             }
         }
 
-        TRACE("device %p: the packet carries motors %u/%u, flag0 %#x, %u bytes, at gain %u%%\n", device,
+        /* MGVF mgvf-0023: flag1 and the power byte are named here for the same
+         * reason flag0 already was -- a field that goes out wrong and a field
+         * that never goes out at all read identically in a log that does not
+         * print it, and this one is the whole of an experiment. */
+        TRACE("device %p: the packet carries motors %u/%u, flag0 %#x, flag1 %#x, power %#x, %u bytes, at gain %u%%\n",
+              device,
               motors[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_MOTOR_RIGHT],
               motors[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_MOTOR_LEFT],
               motors[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_FLAG0],
+              motors[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_FLAG1],
+              out.reportBufferLen > DUALSENSE_USB_COMMON + DUALSENSE_COMMON_MOTOR_POWER
+              ? motors[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_MOTOR_POWER] : 0,
               (unsigned int)out.reportBufferLen,
               dualsense_speaks_bluetooth(ext) ? 100 : ext->haptics_gain);
 
@@ -2269,6 +2279,18 @@
                  " nothing. Set the vibration to the game's own choice to compare the two paths.\n", device);
     }
 
+    /* MGVF mgvf-0023: the motor power field. The option carries the BYTE, not
+     * a yes or no: absent -- or anything from 256 up -- leaves the field
+     * unclaimed, which is what this driver has always sent, and 0 to 255 sets
+     * the bit and writes that byte. dualsense_usb.h has the evidence and says
+     * what a non-zero value is expected to do if the community's reading of
+     * the field is right. */
+    ext->haptics_power = get_device_option(ext->desc.vid, ext->desc.pid, L"XInputRumbleMotorPower",
+                                           DUALSENSE_MOTOR_POWER_UNCLAIMED);
+    if (ext->haptics_power < DUALSENSE_MOTOR_POWER_UNCLAIMED)
+        TRACE("device %p: claiming the motor power field and writing %#x into it, as Sony's library does on"
+              " every packet with 0\n", device, ext->haptics_power);
+
     ext->haptics_ride = get_device_option(ext->desc.vid, ext->desc.pid, L"XInputRumbleRide", 0);
     ext->haptics_sent = -1;
     ext->haptics_client_seen = 0;
@@ -2474,10 +2496,19 @@
         TRACE("device %p: would have ridden the client's 0x31 with motors %u/%u -- dry run, not stamped\n", device, r, l);
         return FALSE;
     }
-    if (!dualsense_bt_stamp_motors(report, DUALSENSE_BT_REPORT_LEN, r, l, ext->haptics_path, dualsense_crc32))
+    if (!dualsense_bt_stamp_motors(report, DUALSENSE_BT_REPORT_LEN, r, l, ext->haptics_path,
+                                   ext->haptics_power, dualsense_crc32))
         return FALSE;
     dualsense_haptics_note_sent(ext, r, l);
-    TRACE("device %p: rode the client's 0x31 with motors %u/%u -- no packet of ours on the link\n", device, r, l);
+    /* MGVF mgvf-0023: and what the stamp actually put in the packet. This is
+     * the only place the ride's bytes can be seen: the client's own write was
+     * already dumped before we touched it, and nothing dumps it again. */
+    TRACE("device %p: rode the client's 0x31 with motors %u/%u, flag0 %#x, flag1 %#x, flag2 %#x, power %#x"
+          " -- no packet of ours on the link\n", device, r, l,
+          report[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_FLAG0],
+          report[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_FLAG1],
+          report[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_FLAG2],
+          report[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_MOTOR_POWER]);
     return TRUE;
 }
 
