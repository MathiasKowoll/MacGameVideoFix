 }
 
+/* MGVF mgvf-0011: does this device carry a HID haptics collection?
+ *
+ * wine's own xinput drives a pad's motors through one, and through nothing
+ * else: it walks the link collections for a Haptics Simple Controller, reads
+ * which waveform each one drives, and writes an intensity beside it. So the
+ * presence of that collection is exactly the question "can xinput rumble this
+ * device", asked of the descriptor rather than of a list of product ids. */
+static BOOL has_haptics_collection( HIDP_COLLECTION_DESC *desc )
+{
+    HIDP_LINK_COLLECTION_NODE *nodes;
+    ULONG count = 0, i;
+    BOOL found = FALSE;
+    HIDP_CAPS caps;
+
+    if (HidP_GetCaps( desc->PreparsedData, &caps ) != HIDP_STATUS_SUCCESS) return FALSE;
+    if (!(count = caps.NumberLinkCollectionNodes)) return FALSE;
+    if (!(nodes = malloc( count * sizeof(*nodes) ))) return FALSE;
+
+    if (HidP_GetLinkCollectionNodes( nodes, &count, desc->PreparsedData ) == HIDP_STATUS_SUCCESS)
+        for (i = 0; i < count && !found; ++i)
+            found = nodes[i].LinkUsagePage == HID_USAGE_PAGE_HAPTICS &&
+                    nodes[i].LinkUsage == HID_USAGE_HAPTICS_SIMPLE_CONTROLLER;
+
+    free( nodes );
+    return found;
+}
