diff --git a/dlls/winegstreamer/media_source.c b/dlls/winegstreamer/media_source.c
--- a/dlls/winegstreamer/media_source.c
+++ b/dlls/winegstreamer/media_source.c
@@ -710,22 +710,112 @@
         flush_token_queue(source->streams[i], FALSE);
 
     return IMFMediaEventQueue_QueueEventParamVar(source->event_queue, MESourceStopped, &GUID_NULL, S_OK, NULL);
+}
+
+/* winevideo: video frames must arrive in a buffer that implements IMF2DBuffer2.
+ *
+ * MFCreateMemoryBuffer makes a plain 1-D buffer, and mfplat's
+ * memory_buffer_QueryInterface answers only IMFMediaBuffer and IUnknown, so a
+ * caller that asks a frame for IMF2DBuffer2 is handed E_NOINTERFACE with the
+ * out-pointer left NULL. Metal Gear Solid Peace Walker asks and does not check
+ * the HRESULT: it loads the vtable from that NULL and dies on its first frame.
+ * video_decoder.c already provides its own samples on macOS for the same
+ * reason; the decoder MFT was covered and this media source was not, so a title
+ * that resolves its own byte stream never benefited.
+ *
+ * MFCreateMediaBufferFromMediaType returns a 2D-capable buffer when the type
+ * carries a subtype and a frame size, and falls back to a 1-D buffer of
+ * min_length when it does not, which is what happened before. Audio is left on
+ * the old path deliberately: it has no geometry, nothing asks it for
+ * IMF2DBuffer2, and the audio branch computes a length of its own.
+ *
+ * luma_size is where the luma plane ends in the buffer's linear view, which is
+ * the planes packed with no row padding. It is what lets an unwritten tail be
+ * filled with black rather than with zeros -- see the fill below. Zero means
+ * the format was not one whose split is known here. */
+static HRESULT media_stream_create_buffer(struct media_stream *stream, DWORD size,
+        DWORD *luma_size, IMFMediaBuffer **buffer)
+{
+    IMFMediaType *media_type;
+    GUID major, subtype;
+    UINT64 frame_size;
+
+    *buffer = NULL;
+    *luma_size = 0;
+
+    if (SUCCEEDED(stream_descriptor_get_media_type(stream->descriptor, &media_type)))
+    {
+        if (SUCCEEDED(IMFMediaType_GetMajorType(media_type, &major)) && IsEqualGUID(&major, &MFMediaType_Video))
+        {
+            MFCreateMediaBufferFromMediaType(media_type, 0, size, 0, buffer);
+
+            if (*buffer
+                    && SUCCEEDED(IMFMediaType_GetGUID(media_type, &MF_MT_SUBTYPE, &subtype))
+                    && SUCCEEDED(IMFMediaType_GetUINT64(media_type, &MF_MT_FRAME_SIZE, &frame_size))
+                    && (IsEqualGUID(&subtype, &MFVideoFormat_NV12)
+                        || IsEqualGUID(&subtype, &MFVideoFormat_I420)
+                        || IsEqualGUID(&subtype, &MFVideoFormat_IYUV)
+                        || IsEqualGUID(&subtype, &MFVideoFormat_YV12)))
+                *luma_size = (DWORD)(frame_size >> 32) * (DWORD)frame_size;
+        }
+        IMFMediaType_Release(media_type);
+    }
+
+    if (*buffer)
+        return S_OK;
+
+    return MFCreateMemoryBuffer(size, buffer);
 }
 
 static HRESULT media_stream_send_sample(struct media_stream *stream, const struct wg_parser_buffer *wg_buffer, IUnknown *token)
 {
     IMFSample *sample = NULL;
     IMFMediaBuffer *buffer;
+    DWORD max_length = 0, luma_size = 0;
     HRESULT hr;
     BYTE *data;
 
-    if (FAILED(hr = MFCreateMemoryBuffer(wg_buffer->size, &buffer)))
+    if (FAILED(hr = media_stream_create_buffer(stream, wg_buffer->size, &luma_size, &buffer)))
         return hr;
     if (FAILED(hr = IMFMediaBuffer_SetCurrentLength(buffer, wg_buffer->size)))
         goto out;
-    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL)))
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, &max_length, NULL)))
         goto out;
 
+    /* A 2D buffer's linear view is sized from the media type; the parser fills
+     * only what it produced. The two are negotiated together and should agree,
+     * but if the view is smaller the copy below would run off the end, so that
+     * frame goes back on a plain buffer rather than trusting they agree. */
+    if (max_length < wg_buffer->size)
+    {
+        IMFMediaBuffer_Unlock(buffer);
+        IMFMediaBuffer_Release(buffer);
+        if (FAILED(hr = MFCreateMemoryBuffer(wg_buffer->size, &buffer)))
+            return hr;
+        if (FAILED(hr = IMFMediaBuffer_SetCurrentLength(buffer, wg_buffer->size)))
+            goto out;
+        if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL)))
+            goto out;
+    }
+    /* And if the view is larger, its tail is never written. Fresh allocations
+     * are not blank, and in YUV a run of zeros is bright green -- which is what
+     * a green band along the bottom of a Peace Walker cutscene was, once the
+     * frames started arriving in 2D buffers at all. Fill it with black: luma 0,
+     * chroma 128. A format whose split is not known here is zeroed, which is at
+     * least the same colour every frame instead of whatever was in the heap. */
+    else if (max_length > wg_buffer->size)
+    {
+        DWORD from = wg_buffer->size;
+
+        if (luma_size > from)
+        {
+            memset(data + from, 0, luma_size - from);
+            from = luma_size;
+        }
+        if (max_length > from)
+            memset(data + from, luma_size ? 0x80 : 0, max_length - from);
+    }
+
     if (!wg_parser_stream_copy_buffer(stream->wg_stream, data, 0, wg_buffer->size))
     {
         hr = S_FALSE;
