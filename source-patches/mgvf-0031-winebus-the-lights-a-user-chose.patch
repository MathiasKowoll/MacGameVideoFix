+/* MGVF mgvf-0031: the lights a user chose, and where they live in the report.
+ *
+ * Common-block numbering, as above. The enable bits are in flag1 and the one
+ * setup bit in flag2:
+ *
+ *   flag1 (common 1)  bit 0x04  lightbar colour, common 44..46 = R G B
+ *   flag1 (common 1)  bit 0x08  release the LEDs (named so a test can prove it
+ *                               is kept, never acted on)
+ *   flag1 (common 1)  bit 0x10  player LEDs, common 43 = instant bit 0x20 |
+ *                               a five-bit pattern
+ *   flag2 (common 38) bit 0x02  lightbar setup, common 41; 0x02 there is
+ *                               "light out"
+ *
+ * Where these come from: Steam's own packets in hid-203611.log (flag1 0x14,
+ * player 0x24 at Bluetooth byte 46, RGB 00 ff ff at 47..49, CRC valid), the
+ * libScePad open in steam-hid-game-145815.log (flag2 0x02, setup 0x02 at byte
+ * 44), and the Linux hid-playstation driver, which names the same fields.
+ *
+ * The registry values carry a marker so that "black" and "the lightbar off"
+ * stay apart from "nothing asked": LightbarColour is 0x01RRGGBB and
+ * PlayerLights is 0x100 | pattern. Anything without the marker -- 0, an absent
+ * value, 0xffffffff, a stray 0x00RRGGBB -- asks for nothing. That is the lesson
+ * of mgvf-0022, where an all-zeros sentinel collided with a real request. */
+#define DUALSENSE_FLAG1_LIGHTBAR            0x04
+#define DUALSENSE_FLAG1_RELEASE_LEDS        0x08
+#define DUALSENSE_FLAG1_PLAYER_LEDS         0x10
+#define DUALSENSE_FLAG2_LIGHTBAR_SETUP      0x02
+#define DUALSENSE_COMMON_LIGHTBAR_SETUP     41
+#define DUALSENSE_COMMON_PLAYER_LEDS        43
+#define DUALSENSE_COMMON_LIGHTBAR           44
+#define DUALSENSE_LIGHTBAR_SETUP_LIGHT_OUT  0x02
+#define DUALSENSE_PLAYER_LEDS_INSTANT       0x20
+#define DUALSENSE_PLAYER_LEDS_PATTERN       0x1f
+#define DUALSENSE_LIGHTBAR_SET_MASK         0xff000000
+#define DUALSENSE_LIGHTBAR_SET              0x01000000
+#define DUALSENSE_PLAYER_LIGHTS_SET_MASK    0xffffff00
+#define DUALSENSE_PLAYER_LIGHTS_SET         0x100
 
+/* The shortest USB 0x02 that carries the last lightbar byte, common 46. Both
+ * pads measured here declare 48 or 64, so this is exactly a DualSense's 0x02. */
+#define DUALSENSE_USB_OUTPUT_LIGHTS_MIN (DUALSENSE_USB_COMMON + DUALSENSE_COMMON_LIGHTBAR + 3)
+
+/* LightbarRelease: whether, and how, a pad on Bluetooth is sent the lightbar
+ * setup release before the first colour a client writes after the device
+ * arrives. Linux hid-playstation says a Bluetooth DualSense ignores lightbar
+ * programming until it has had one, and Steam never sends one (0 of 1858
+ * packets in hid-203611.log). WHETHER THIS PAD NEEDS IT, AND WHICH OF THE TWO
+ * FORMS WORKS, IS NOT MEASURED; the value exists so both can be tried without a
+ * rebuild.
+ *
+ *   NEVER     0  send nothing of the kind
+ *   SEPARATE  1  the default: one release-only report of ours, from the same
+ *                client write and just before it
+ *   FOLD      2  no packet of ours: flag2 0x02 and common 41 = 0x02 are set in
+ *                that first client lightbar packet itself */
+#define DUALSENSE_LIGHTBAR_RELEASE_NEVER    0
+#define DUALSENSE_LIGHTBAR_RELEASE_SEPARATE 1
+#define DUALSENSE_LIGHTBAR_RELEASE_FOLD     2
+
+struct dualsense_lights
+{
+    unsigned int bar;          /* non-zero: replace the lightbar colour */
+    unsigned char rgb[3];
+    unsigned int player;       /* non-zero: replace the player LED pattern */
+    unsigned char pattern;
+    unsigned int release;      /* DUALSENSE_LIGHTBAR_RELEASE_* */
+};
+#define DUALSENSE_LIGHTS_NONE { 0, {0, 0, 0}, 0, 0, DUALSENSE_LIGHTBAR_RELEASE_NEVER }
+static inline int dualsense_lights_wanted(const struct dualsense_lights *lights)
+{
+    return lights->bar || lights->player;
+}
+
+/* What a rewrite did, for the caller to trace. Filled in whenever the pointer
+ * is passed, changed or not. */
+struct dualsense_lights_change
+{
+    unsigned char changed;
+    unsigned char folded;      /* the release was folded into this packet */
+    unsigned char flag1;
+    unsigned char rgb_before[3], rgb_after[3];
+    unsigned char player_before, player_after;
+};
+
+/* The three registry values, decoded. Pure, so the host test can hold the
+ * table; main.c reads the values and passes them in. */
+void dualsense_lights_from_values(unsigned int bar, unsigned int player, unsigned int release,
+                                  struct dualsense_lights *out);
+
+/* Whether a report is a client lightbar write the override applies to: a
+ * 78-byte 0x31 or a 0x02 of DUALSENSE_USB_OUTPUT_LIGHTS_MIN..64 bytes, with
+ * flag1 0x04 set. */
+int dualsense_lights_bar_asked(const unsigned char *report, unsigned int len);
+
+/* Rewrite the lights in a CLIENT packet, in place, only in the fields whose
+ * enable bit the client set itself. No flag bit is ever set or cleared, except
+ * that fold_release adds the lightbar setup (flag2 0x02, common 41 = 0x02) to a
+ * packet whose lightbar is rewritten. The player byte keeps the client's
+ * instant bit. Each returns len when a byte changed and 0 when none did; the
+ * Bluetooth one signs the packet again only then. change may be NULL. */
+unsigned int dualsense_bt_lights_fixup(unsigned char *report, unsigned int len,
+                                       const struct dualsense_lights *lights, int fold_release,
+                                       dualsense_crc32_fn crc32, struct dualsense_lights_change *change);
+unsigned int dualsense_usb_lights_fixup(unsigned char *report, unsigned int len,
+                                        const struct dualsense_lights *lights, int fold_release,
+                                        struct dualsense_lights_change *change);
+
+/* The release-only report: flag2 0x02, common 41 = 0x02, every other byte
+ * zero. The Bluetooth form is a signed 78-byte 0x31 with the header 31 00 10;
+ * the USB form is a 0x02 of len bytes (DUALSENSE_USB_OUTPUT_LIGHTS_MIN..64) for
+ * the emulated route, which translates and signs it itself. Each returns the
+ * number of bytes written, or 0. */
+unsigned int dualsense_bt_lights_release_report(unsigned char *out, unsigned int out_size,
+                                                dualsense_crc32_fn crc32);
+unsigned int dualsense_usb_lights_release_report(unsigned char *out, unsigned int out_size,
+                                                 unsigned int len);
+
 #endif /* __WINEBUS_DUALSENSE_USB_H */
--- a/dlls/winebus.sys/dualsense_usb.c
+++ b/dlls/winebus.sys/dualsense_usb.c
@@ -693,4 +693,184 @@
     if (!emulated) return DUALSENSE_FEATURE_WRITE_FORWARD;
     if (forward_option) return DUALSENSE_FEATURE_WRITE_FORWARD;
     return DUALSENSE_FEATURE_WRITE_SWALLOW;
+}
+
+/* MGVF mgvf-0031: the lights a user chose, stamped into the light changes a
+ * client already sends.
+ *
+ * WHAT WAS MEASURED. In hid-203611.log, a Bluetooth session of Mortal Shell 2
+ * under Steam Input, 8 of 1858 client writes set a light, and a ninth is
+ * Steam's 00/08 release-LEDs packet, which sets none. At each config activation,
+ * and again on a reconnect, Steam sends player 0x24 with RGB 00ffff (flag1
+ * 0x14), then RGB 00ffff alone (flag1 0x04), then player 0x00 with 00ffff
+ * (flag1 0x14). The Desktop activation is different: 00/08, then player 0x00
+ * with 00ffff (flag1 0x14), then 00ffff alone, and no 0x24. The game itself
+ * sends no light. No packet in that session ever carries the lightbar setup.
+ *
+ * WHAT THIS DOES. Only the fields whose enable bit the client set are
+ * replaced, in the client's own packet: the colour when flag1 0x04 is set, the
+ * player pattern when flag1 0x10 is set. The player byte keeps the client's
+ * instant bit 0x20, because Steam and SDL both send 0x24. A packet with neither
+ * bit -- the all-zero packet, SDL's motor packets, the haptics thread's motor
+ * report, Steam's 00/08 release -- cannot match and is left byte for byte. No
+ * flag bit is set or cleared, so nothing the client asked for is taken away
+ * and nothing it did not ask for is added -- with one exception, the release
+ * folded in on request (LightbarRelease 2), which main.c asks for at most once
+ * per arrival.
+ *
+ * WHAT IS NOT CLAIMED. That the pad shows the colour: over Bluetooth it may
+ * ignore lightbar programming until it has had a setup release, which is what
+ * LightbarRelease is there to find out. And a client that never sends a light
+ * change gets nothing from this. */
+void dualsense_lights_from_values(unsigned int bar, unsigned int player, unsigned int release,
+                                  struct dualsense_lights *out)
+{
+    memset(out, 0, sizeof(*out));
+    if ((bar & DUALSENSE_LIGHTBAR_SET_MASK) == DUALSENSE_LIGHTBAR_SET)
+    {
+        out->bar = 1;
+        out->rgb[0] = (bar >> 16) & 0xff;
+        out->rgb[1] = (bar >> 8) & 0xff;
+        out->rgb[2] = bar & 0xff;
+    }
+    if ((player & DUALSENSE_PLAYER_LIGHTS_SET_MASK) == DUALSENSE_PLAYER_LIGHTS_SET)
+    {
+        out->player = 1;
+        out->pattern = player & DUALSENSE_PLAYER_LEDS_PATTERN;
+    }
+    /* An unknown value is the default rather than never: the default is the
+     * form the Linux driver's reading of the firmware asks for. */
+    out->release = release <= DUALSENSE_LIGHTBAR_RELEASE_FOLD ? release : DUALSENSE_LIGHTBAR_RELEASE_SEPARATE;
+}
+
+int dualsense_lights_bar_asked(const unsigned char *report, unsigned int len)
+{
+    if (len == DUALSENSE_BT_REPORT_LEN && report[0] == DUALSENSE_BT_REPORT_ID)
+        return !!(report[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_FLAG1] & DUALSENSE_FLAG1_LIGHTBAR);
+    if (len >= DUALSENSE_USB_OUTPUT_LIGHTS_MIN && len <= DUALSENSE_USB_OUTPUT_MAX
+        && report[0] == DUALSENSE_USB_OUTPUT_ID)
+        return !!(report[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_FLAG1] & DUALSENSE_FLAG1_LIGHTBAR);
+    return 0;
+}
+
+static unsigned char dualsense_lights_rewrite(unsigned char *common, const struct dualsense_lights *lights,
+                                              int fold_release, struct dualsense_lights_change *change)
+{
+    unsigned char changed = 0, folded = 0, player;
+    unsigned char flag1 = common[DUALSENSE_COMMON_FLAG1];
+    unsigned int i;
+
+    if (change)
+    {
+        memset(change, 0, sizeof(*change));
+        change->flag1 = flag1;
+        memcpy(change->rgb_before, common + DUALSENSE_COMMON_LIGHTBAR, 3);
+        change->player_before = common[DUALSENSE_COMMON_PLAYER_LEDS];
+    }
+
+    if (lights->bar && (flag1 & DUALSENSE_FLAG1_LIGHTBAR))
+    {
+        for (i = 0; i < 3; i++)
+        {
+            if (common[DUALSENSE_COMMON_LIGHTBAR + i] == lights->rgb[i]) continue;
+            common[DUALSENSE_COMMON_LIGHTBAR + i] = lights->rgb[i];
+            changed = 1;
+        }
+        if (fold_release)
+        {
+            if (!(common[DUALSENSE_COMMON_FLAG2] & DUALSENSE_FLAG2_LIGHTBAR_SETUP)
+                || common[DUALSENSE_COMMON_LIGHTBAR_SETUP] != DUALSENSE_LIGHTBAR_SETUP_LIGHT_OUT)
+            {
+                common[DUALSENSE_COMMON_FLAG2] |= DUALSENSE_FLAG2_LIGHTBAR_SETUP;
+                common[DUALSENSE_COMMON_LIGHTBAR_SETUP] = DUALSENSE_LIGHTBAR_SETUP_LIGHT_OUT;
+                changed = 1;
+            }
+            folded = 1;
+        }
+    }
+
+    if (lights->player && (flag1 & DUALSENSE_FLAG1_PLAYER_LEDS))
+    {
+        player = (common[DUALSENSE_COMMON_PLAYER_LEDS] & DUALSENSE_PLAYER_LEDS_INSTANT) | lights->pattern;
+        if (common[DUALSENSE_COMMON_PLAYER_LEDS] != player)
+        {
+            common[DUALSENSE_COMMON_PLAYER_LEDS] = player;
+            changed = 1;
+        }
+    }
+
+    if (change)
+    {
+        change->changed = changed;
+        change->folded = folded;
+        memcpy(change->rgb_after, common + DUALSENSE_COMMON_LIGHTBAR, 3);
+        change->player_after = common[DUALSENSE_COMMON_PLAYER_LEDS];
+    }
+    return changed;
 }
+
+unsigned int dualsense_bt_lights_fixup(unsigned char *report, unsigned int len,
+                                       const struct dualsense_lights *lights, int fold_release,
+                                       dualsense_crc32_fn crc32, struct dualsense_lights_change *change)
+{
+    static const unsigned char seed = DUALSENSE_CRC_SEED_OUTPUT;
+    unsigned int crc;
+
+    if (change) memset(change, 0, sizeof(*change));
+    if (len != DUALSENSE_BT_REPORT_LEN || report[0] != DUALSENSE_BT_REPORT_ID) return 0;
+    if (!dualsense_lights_wanted(lights)) return 0;
+    if (!dualsense_lights_rewrite(report + DUALSENSE_BT_COMMON, lights, fold_release, change)) return 0;
+
+    crc = crc32(0, &seed, 1);
+    crc = crc32(crc, report, DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL);
+    dualsense_store_crc(report + DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL, crc);
+    return len;
+}
+
+/* A wired 0x02 is not signed, and one shorter than 48 bytes does not carry the
+ * whole lightbar, so it is left alone rather than half rewritten. */
+unsigned int dualsense_usb_lights_fixup(unsigned char *report, unsigned int len,
+                                        const struct dualsense_lights *lights, int fold_release,
+                                        struct dualsense_lights_change *change)
+{
+    if (change) memset(change, 0, sizeof(*change));
+    if (len < DUALSENSE_USB_OUTPUT_LIGHTS_MIN || len > DUALSENSE_USB_OUTPUT_MAX) return 0;
+    if (report[0] != DUALSENSE_USB_OUTPUT_ID) return 0;
+    if (!dualsense_lights_wanted(lights)) return 0;
+    if (!dualsense_lights_rewrite(report + DUALSENSE_USB_COMMON, lights, fold_release, change)) return 0;
+    return len;
+}
+
+/* The release-only report. flag0 and flag1 are zero and so are both motors,
+ * so mgvf-0009's rewrite finds nothing to change in it at any gain or mode,
+ * and flag2 carries 0x02 without the haptic bit 0x04. */
+unsigned int dualsense_bt_lights_release_report(unsigned char *out, unsigned int out_size,
+                                                dualsense_crc32_fn crc32)
+{
+    static const unsigned char seed = DUALSENSE_CRC_SEED_OUTPUT;
+    unsigned int crc;
+
+    if (out_size < DUALSENSE_BT_REPORT_LEN) return 0;
+    memset(out, 0, DUALSENSE_BT_REPORT_LEN);
+    out[0] = DUALSENSE_BT_REPORT_ID;
+    out[1] = 0x00;
+    out[2] = 0x10;
+    out[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_FLAG2] = DUALSENSE_FLAG2_LIGHTBAR_SETUP;
+    out[DUALSENSE_BT_COMMON + DUALSENSE_COMMON_LIGHTBAR_SETUP] = DUALSENSE_LIGHTBAR_SETUP_LIGHT_OUT;
+
+    crc = crc32(0, &seed, 1);
+    crc = crc32(crc, out, DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL);
+    dualsense_store_crc(out + DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL, crc);
+    return DUALSENSE_BT_REPORT_LEN;
+}
+
+unsigned int dualsense_usb_lights_release_report(unsigned char *out, unsigned int out_size,
+                                                 unsigned int len)
+{
+    if (len < DUALSENSE_USB_OUTPUT_LIGHTS_MIN || len > DUALSENSE_USB_OUTPUT_MAX || out_size < len) return 0;
+    memset(out, 0, len);
+    out[0] = DUALSENSE_USB_OUTPUT_ID;
+    out[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_FLAG2] = DUALSENSE_FLAG2_LIGHTBAR_SETUP;
+    out[DUALSENSE_USB_COMMON + DUALSENSE_COMMON_LIGHTBAR_SETUP] = DUALSENSE_LIGHTBAR_SETUP_LIGHT_OUT;
+    return len;
+}
