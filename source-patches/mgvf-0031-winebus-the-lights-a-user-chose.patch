+/* MGVF mgvf-0031: the lights a user chose, in a CLIENT packet.
+ *
+ * Called only from the three client write paths below -- the native Bluetooth
+ * 0x31, the wired 0x02 and the emulated 0x02 -- on a copy, and never from
+ * dualsense_usb_set_output_report, which the haptics thread also calls. So no
+ * packet of ours is ever read back here, and nothing is kept but the one claim
+ * that the release has been done for this arrival.
+ *
+ * THE RELEASE. On Bluetooth only, with a lightbar colour set, before the first
+ * client lightbar packet the override applies to: LightbarRelease 1 sends one
+ * release-only report of ours from this same client call, just before the
+ * client's packet; 2 folds the same two fields into the client's packet
+ * instead and adds nothing. Claimed before the write, not after: a failed
+ * release is not retried this arrival. ext->cs already serialises the writes.
+ * Whether the pad needs either form is not measured -- the Linux driver says a
+ * Bluetooth DualSense ignores lightbar programming without it, and Steam never
+ * sends one.
+ *
+ * *folded says the caller must trace the folded release once its own write has
+ * a status. Returns TRUE when a byte of the copy changed. */
+static BOOL dualsense_lights_fixup(DEVICE_OBJECT *device, BYTE *report, ULONG len, const char *route, BOOL *folded)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    struct dualsense_lights_change change;
+    BOOL fold = FALSE, changed;
+
+    *folded = FALSE;
+    if (!dualsense_lights_wanted(&ext->dualsense_lights)) return FALSE;
+
+    if (ext->dualsense_lights.bar && ext->dualsense_lights.release != DUALSENSE_LIGHTBAR_RELEASE_NEVER
+        && dualsense_speaks_bluetooth(ext) && dualsense_lights_bar_asked(report, len)
+        && !InterlockedCompareExchange(&ext->dualsense_lights_released, 1, 0))
+    {
+        if (ext->dualsense_lights.release == DUALSENSE_LIGHTBAR_RELEASE_FOLD) fold = TRUE;
+        else
+        {
+            BYTE release[DUALSENSE_BT_REPORT_LEN];
+            HID_XFER_PACKET out = {.reportBuffer = release};
+            IO_STATUS_BLOCK io = {0};
+
+            if (report[0] == DUALSENSE_BT_REPORT_ID)
+            {
+                out.reportId = DUALSENSE_BT_REPORT_ID;
+                out.reportBufferLen = dualsense_bt_lights_release_report(release, sizeof(release), dualsense_crc32);
+                unix_device_set_output_report(device, &out, &io);
+            }
+            else
+            {
+                /* the emulated route: a 0x02 of the client's own length, which
+                 * the translation turns into a signed 0x31 like any other */
+                out.reportId = DUALSENSE_USB_OUTPUT_ID;
+                out.reportBufferLen = dualsense_usb_lights_release_report(release, sizeof(release), len);
+                dualsense_usb_set_output_report(device, &out, &io);
+            }
+            TRACE("device %p: released the lightbar before the first colour (separate packet), status %#lx\n",
+                  device, io.Status);
+            if (io.Status)
+                WARN("device %p: the lightbar release could not be written, status %#lx -- it is not tried again"
+                     " until the pad next arrives\n", device, io.Status);
+        }
+    }
+
+    changed = dualsense_bt_lights_fixup(report, len, &ext->dualsense_lights, fold, dualsense_crc32, &change)
+              || dualsense_usb_lights_fixup(report, len, &ext->dualsense_lights, fold, &change);
+    *folded = fold;
+    if (changed)
+        TRACE("device %p: set the client's lights (%s) -- flag1 %#x, lightbar %02x%02x%02x -> %02x%02x%02x,"
+              " player %#x -> %#x -- no packet of ours on the link\n", device, route, change.flag1,
+              change.rgb_before[0], change.rgb_before[1], change.rgb_before[2],
+              change.rgb_after[0], change.rgb_after[1], change.rgb_after[2],
+              change.player_before, change.player_after);
+    return changed;
 }
 
