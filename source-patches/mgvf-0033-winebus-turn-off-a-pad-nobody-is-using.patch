+/* MGVF mgvf-0033: turn off a pad nobody is using.
+ *
+ * THE FAULT. A DualSense that connects over Bluetooth while this process
+ * already holds the match gets no macOS GameController plugin, so neither
+ * macOS's 900 s idle cut (mgvf-0006's header) nor, in the connections
+ * retained, the pad's own power-off after about eleven minutes happens to it.
+ * Measured from macOS's and Steam's own logs: on 2026-09-12/13 such a pad
+ * connected at 23:28:10, the game and Steam were gone by 00:07:48, and the pad
+ * ran on until 03:21:07, when it dropped by itself and the next connection
+ * reported 0 % battery -- 3 h 13 min with, very likely, no wine process left.
+ * On 2026-09-13 the same happened for 27 minutes after wine exited at
+ * 22:15:44. So the drain that was reported happened after this process was
+ * gone, and nothing in this file could have prevented it. What this file can
+ * do is not let the same pad sit untouched for hours while a game still holds
+ * it.
+ *
+ * THE MECHANISM, measured on 2026-09-14 on a DualSense Edge (054c:0df2) over
+ * Bluetooth with no wine running: feature report 0x08 of 48 bytes -- 0x08,
+ * 0x02, zeros, and the Bluetooth CRC-32 (seed byte 0x53 and the first 44
+ * bytes) little-endian in the last four -- sent with IOHIDDeviceSetReport
+ * returned 0, and 63 ms (shared open) and 64 ms (seized open, as here) later
+ * bluetoothd logged the pad's own disconnect, HID reason 431 / ACL 10719. The
+ * light went out and the pad did not come back until PS was pressed. The CRC
+ * tail for this content is e0 ef a2 23, the tail mgvf-0005 appended to
+ * libScePad's write of the same report on 2026-09-08. dualsensectl sends the
+ * same report as its power-off. A plain DualSense 054c:0ce6 did the same, 62 ms.
+ *
+ * THE RULE. While this process holds a DualSense on Bluetooth with
+ * kIOHIDOptionsTypeSeizeDevice and the device has been started, a pad with no
+ * stick, trigger or button input (see dualsense_activity_snapshot) for the
+ * limit is sent that report once. Once: a failed or ignored request is not
+ * repeated every ten seconds, and a reconnect is a new device with a fresh
+ * clock. A pad opened shared keeps macOS's own cut and is left alone. The
+ * clock is CLOCK_UPTIME_RAW, which does not advance while the Mac sleeps;
+ * macOS disconnects a Bluetooth pad on sleep anyway.
+ *
+ *   HKLM\System\CurrentControlSet\Services\winebus\Devices\<vid>/<pid>
+ *     IdlePowerOffMinutes  REG_DWORD  absent: 20 for 054c/0ce6 and 054c/0df2.
+ *                                     0: never. Otherwise clamped to 5..240.
+ *
+ * The 20 is a reasoned default, not a measurement: above the pad's own
+ * power-off (686 s, measured once, on a pad macOS was driving) and above
+ * macOS's 900 s cut, so a held pad is never turned off sooner than one macOS
+ * drives would have been. The value is ignored for any other device: the
+ * report is a DualSense's. */
+#define IOHID_IDLE_POWER_OFF_DEFAULT_MINUTES 20
+#define IOHID_IDLE_POWER_OFF_MIN_MINUTES 5
+#define IOHID_IDLE_POWER_OFF_MAX_MINUTES 240
+#define IOHID_IDLE_CHECK_INTERVAL_NS (10 * IOHID_NSEC_PER_SEC)
+#define DUALSENSE_BT_POWER_OFF_ID 0x08
+#define DUALSENSE_BT_POWER_OFF_LEN 48
+
+static UInt64 idle_power_off_limit_ns(const struct device_desc *desc, IOOptionBits open_options)
+{
+    const struct device_options *device;
+    UINT minutes = IOHID_IDLE_POWER_OFF_DEFAULT_MINUTES;
+
+    if (desc->bus_type != BUS_TYPE_BLUETOOTH || !is_dualsense_gamepad(desc->vid, desc->pid)) return 0;
+    if (open_options != kIOHIDOptionsTypeSeizeDevice) return 0;
+
+    if (options) LIST_FOR_EACH_ENTRY(device, &options->devices, struct device_options, entry)
+    {
+        if (device->vid != desc->vid) continue;
+        if (device->pid != -1 && device->pid != desc->pid) continue;
+        if (device->idle_power_off_minutes == -1) continue;
+        minutes = (UINT)device->idle_power_off_minutes;
+        break;
+    }
+
+    if (!minutes) return 0;
+    if (minutes < IOHID_IDLE_POWER_OFF_MIN_MINUTES) minutes = IOHID_IDLE_POWER_OFF_MIN_MINUTES;
+    if (minutes > IOHID_IDLE_POWER_OFF_MAX_MINUTES) minutes = IOHID_IDLE_POWER_OFF_MAX_MINUTES;
+    return (UInt64)minutes * 60 * IOHID_NSEC_PER_SEC;
+}
+
+/* zlib's CRC-32, bit by bit. The unix half has neither ntdll's
+ * RtlComputeCrc32 nor dualsense_usb.c, which is built into the PE half only,
+ * so the one feature report written from here carries its own. */
+static UInt32 iohid_crc32(UInt32 crc, const uint8_t *data, size_t len)
+{
+    int bit;
+
+    crc = ~crc;
+    while (len--)
+    {
+        crc ^= *data++;
+        for (bit = 0; bit < 8; bit++) crc = (crc >> 1) ^ (0xedb88320 & (0 - (crc & 1)));
+    }
+    return ~crc;
+}
+
+static IOReturn dualsense_bt_request_power_off(IOHIDDeviceRef device)
+{
+    static const uint8_t seed = 0x53;
+    uint8_t report[DUALSENSE_BT_POWER_OFF_LEN] = {DUALSENSE_BT_POWER_OFF_ID, 0x02};
+    UInt32 crc;
+
+    crc = iohid_crc32(0, &seed, 1);
+    crc = iohid_crc32(crc, report, DUALSENSE_BT_POWER_OFF_LEN - 4);
+    report[DUALSENSE_BT_POWER_OFF_LEN - 4] = crc;
+    report[DUALSENSE_BT_POWER_OFF_LEN - 3] = crc >> 8;
+    report[DUALSENSE_BT_POWER_OFF_LEN - 2] = crc >> 16;
+    report[DUALSENSE_BT_POWER_OFF_LEN - 1] = crc >> 24;
+
+    return IOHIDDeviceSetReport(device, kIOHIDReportTypeFeature, DUALSENSE_BT_POWER_OFF_ID,
+                                report, sizeof(report));
+}
+
+/* Called from the bus loop on every pass, and does its work at most every ten
+ * seconds. The list is walked under iohid_cs, but the report is sent after it
+ * is released: a Bluetooth feature write to a pad that is turning itself off
+ * must not keep iohid_device_stop, which takes the lock, waiting behind it.
+ * The IOHIDDeviceRef is retained across that window, and nothing of the
+ * iohid_device is touched once the lock is gone. */
+static void iohid_power_off_idle_pads(void)
+{
+    static UInt64 next_check_ns;
+    struct iohid_device *impl;
+    UInt64 now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+
+    if (now < next_check_ns) return;
+    next_check_ns = now + IOHID_IDLE_CHECK_INTERVAL_NS;
+
+    for (;;)
+    {
+        IOHIDDeviceRef device = NULL;
+        unsigned int idle_s = 0;
+        WORD vid = 0, pid = 0;
+        IOReturn ret;
+
+        pthread_mutex_lock(&iohid_cs);
+        LIST_FOR_EACH_ENTRY(impl, &device_list, struct iohid_device, unix_device.entry)
+        {
+            if (!impl->idle_armed || impl->power_off_requested) continue;
+            /* started on the PE side after now was read: not idle, and not a
+             * subtraction that wraps */
+            if (impl->last_activity_ns >= now) continue;
+            if (now - impl->last_activity_ns < impl->idle_limit_ns) continue;
+            impl->power_off_requested = TRUE;
+            impl->power_off_request_ns = now;
+            idle_s = (now - impl->last_activity_ns) / IOHID_NSEC_PER_SEC;
+            vid = impl->vid;
+            pid = impl->pid;
+            device = impl->device;
+            CFRetain(device);
+            break;
+        }
+        pthread_mutex_unlock(&iohid_cs);
+        if (!device) break;
+
+        ret = dualsense_bt_request_power_off(device);
+        FIXME("DualSense %04x:%04x had no input for %u s while this process held it;"
+              " asking it to turn itself off (feature 0x08): %#x\n", vid, pid, idle_s, ret);
+        CFRelease(device);
+    }
+}
