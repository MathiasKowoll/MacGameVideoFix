+/* MGVF mgvf-0033: what counts as someone using a DualSense on Bluetooth.
+ *
+ * Only sticks, triggers and buttons, compared with the last report that
+ * counted -- not with the previous report, because the sticks of a pad lying
+ * on a table jitter all the time. Normalised into ten bytes: four sticks,
+ * two triggers, four button bytes.
+ *
+ * The 78-byte 0x31 (id, header, X Y Z Rz, L2 R2, sequence, buttons): sticks
+ * 2..5, triggers 6..7, buttons 9, 10, 11 and 12. Byte 11 is taken whole.
+ * In every seized trace read for this (hid-090147, hid-203611 and hid-114844
+ * on 054c:0df2, hid-175158 on 054c:0ce6; 2855, 2861, 522 and 3721 decoded
+ * reports) none of its eight bits changed while the sticks and the other
+ * buttons were still, so masking it gains nothing and would drop whatever an
+ * Edge keeps in its upper bits. Byte 12 is counted too: the raw 0x31 is in
+ * 33 traces (1569 to 111642 reports each, both models) and byte 12 never
+ * changed in any of them, so it costs no false activity. Only bits 0x01 and
+ * 0x02 of byte 11 ever changed in those traces; no trace has an Edge Fn
+ * button or back paddle pressed, so where the Edge reports those is not
+ * measured -- counting bytes 11 and 12 whole covers both places.
+ *
+ * The 10-byte 0x01 the pad sends until a feature report is read from it
+ * (id, X Y Z Rz, buttons[3], L2 R2): sticks 1..4, triggers 8..9, buttons 5, 6
+ * and 7 & 0x03. The rest of byte 7 is a counter -- bits 2 to 5 toggled on
+ * every report in hid-090147 -- and unmasked it counted 1572 false changes in
+ * one minute there.
+ *
+ * Gyro, accelerometer, timestamps, battery and the touchpad are ignored. So a
+ * pad held perfectly still in the hand, or used only for motion aiming or
+ * touch gestures, is a pad nobody is using. A stick or trigger counts when it
+ * moves more than 4 from the reference: in the idle minutes of hid-175158 and
+ * hid-114844 no stick moved more than 2 from it, and in play in hid-203611 the
+ * same rule fired 400 to 1700 times a minute. */
+#define IOHID_ACTIVITY_DEADBAND 4
+#define IOHID_NSEC_PER_SEC 1000000000ull
+
+static BOOL dualsense_activity_snapshot(uint8_t *out, const uint8_t *report, CFIndex length)
+{
+    if (length >= 13 && report[0] == 0x31)
+    {
+        memcpy(out, report + 2, 6);
+        out[6] = report[9];
+        out[7] = report[10];
+        out[8] = report[11];
+        out[9] = report[12];
+        return TRUE;
+    }
+    if (length == 10 && report[0] == 0x01)
+    {
+        memcpy(out, report + 1, 4);
+        out[4] = report[8];
+        out[5] = report[9];
+        out[6] = report[5];
+        out[7] = report[6];
+        out[8] = report[7] & 0x03;
+        out[9] = 0;
+        return TRUE;
+    }
+    return FALSE;
 }
 
+static void iohid_device_note_input(struct iohid_device *impl, const uint8_t *report, CFIndex length)
+{
+    uint8_t snapshot[sizeof(impl->activity_ref)];
+    UInt64 now;
+    int i;
+
+    if (!impl->idle_armed) return;
+    if (!dualsense_activity_snapshot(snapshot, report, length)) return;
+
+    if (impl->activity_ref_valid)
+    {
+        for (i = 0; i < 6; i++)
+            if (abs((int)snapshot[i] - (int)impl->activity_ref[i]) > IOHID_ACTIVITY_DEADBAND) break;
+        if (i == 6 && !memcmp(snapshot + 6, impl->activity_ref + 6, 4)) return;
+    }
+
+    memcpy(impl->activity_ref, snapshot, sizeof(snapshot));
+    impl->activity_ref_valid = TRUE;
+    now = clock_gettime_nsec_np(CLOCK_UPTIME_RAW);
+
+    if (impl->power_off_requested && !impl->power_off_ignored_logged)
+    {
+        TRACE("DualSense %04x:%04x: input again %u s after the power-off request and no removal;"
+              " the pad did not turn off, and it is not asked again until it reconnects\n",
+              impl->vid, impl->pid, (unsigned int)((now - impl->power_off_request_ns) / IOHID_NSEC_PER_SEC));
+        impl->power_off_ignored_logged = TRUE;
+    }
+    impl->last_activity_ns = now;
+}
