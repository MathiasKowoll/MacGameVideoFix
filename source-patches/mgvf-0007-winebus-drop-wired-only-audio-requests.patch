     static const unsigned char seed = DUALSENSE_CRC_SEED_OUTPUT;
+    unsigned char dropped;
     unsigned int crc;
 
     if (in_len < 2 || in_len > DUALSENSE_USB_OUTPUT_MAX || in[0] != DUALSENSE_USB_OUTPUT_ID) return 0;
@@ -247,6 +322,9 @@
     out[2] = 0x10;
     memcpy(out + 3, in + 1, in_len - 1);
 
+    dropped = dualsense_bt_drop_audio(out, in_len);
+    if (audio_dropped) *audio_dropped = dropped;
+
     crc = crc32(0, &seed, 1);
     crc = crc32(crc, out, DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL);
     dualsense_store_crc(out + DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL, crc);
--- a/dlls/winebus.sys/dualsense_usb.h
+++ b/dlls/winebus.sys/dualsense_usb.h
@@ -58,6 +58,26 @@
 #define DUALSENSE_USB_OUTPUT_ID    0x02
 #define DUALSENSE_USB_OUTPUT_MAX   64
 
+/* MGVF mgvf-0007: the audio group of the output report.
+ *
+ * Byte 1 of the output report is the first validity-flag byte: a client sets a
+ * bit there for each field of the report it means the pad to act on. The top
+ * nibble is the audio group, one bit per byte, and the four bytes it enables
+ * sit together after the two motors:
+ *
+ *   0x10 -> byte 5   0x20 -> byte 6   0x40 -> byte 7   0x80 -> byte 8
+ *
+ * Three volume or gain bytes and an audio-control byte. Which bit goes with
+ * which byte was read out of Sony's own libScePad, not assumed; dualsense_usb.c
+ * names the addresses it was read at. The pad's speaker, headphone jack and
+ * microphone are reachable only on a cable, so these are the requests the USB
+ * emulation takes back out of a report before it goes over Bluetooth. */
+#define DUALSENSE_USB_OUTPUT_FLAG0            1
+#define DUALSENSE_USB_OUTPUT_AUDIO_FLAGS      0xf0
+#define DUALSENSE_USB_OUTPUT_AUDIO_FIRST_FLAG 0x10
+#define DUALSENSE_USB_OUTPUT_AUDIO_FIRST_BYTE 5
+#define DUALSENSE_USB_OUTPUT_AUDIO_COUNT      4
+
 /* The feature report whose read switches the pad to its full input report;
  * calibration data, 41 bytes, present in both descriptors. */
 #define DUALSENSE_FEATURE_CALIBRATION      0x05
@@ -81,9 +101,15 @@
