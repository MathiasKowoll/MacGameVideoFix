 static void dualsense_usb_set_output_report(DEVICE_OBJECT *device, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io);
+
+/* MGVF mgvf-0019: whether the bytes will actually travel over a radio.
+ *
+ * ext->desc.bus_type answers a different question, and this file needs both.
+ * It says WHICH DESCRIPTOR THE GUEST WAS GIVEN -- which is what
+ * dualsense_bt_input_describe and get_compatible_ids want, and they are right
+ * to ask it. It does NOT say which transport a packet leaves by, because
+ * mgvf-0005 sets it to USB for a pad that is physically on Bluetooth.
+ *
+ * Three places asked it the second question and got the first answer. With
+ * UsbEmulation and XInputRumble both on -- a pair the launcher offers together
+ * -- the haptics thread concluded "cable", applied the gain here instead of
+ * downstream, and wrote a raw 0x02 to a pad whose Bluetooth descriptor declares
+ * no such report. Every write was refused and XInput rumble did nothing at all,
+ * silently, for as long as that pair was set.
+ *
+ * HIDRAW_FIXUP_DUALSENSE_USB is set only by dualsense_usb_emulation_fixups,
+ * which returns early for anything that did not arrive over Bluetooth, and
+ * hidraw_disable_report_fixups deliberately never clears it. So it means
+ * "physically on Bluetooth and being presented otherwise", exactly. */
+static BOOL dualsense_speaks_bluetooth(const struct device_extension *ext)
+{
+    return (ext->report_fixups & HIDRAW_FIXUP_DUALSENSE_USB) || ext->desc.bus_type == BUS_TYPE_BLUETOOTH;
+}
 
