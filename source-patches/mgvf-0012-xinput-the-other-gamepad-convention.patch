+
+    if (controller->hid.sony_layout) switch (usage)
     {
     case HID_USAGE_GENERIC_X: controller->hid.lx_caps = *caps; break;
     case HID_USAGE_GENERIC_Y: controller->hid.ly_caps = *caps; break;
+    case HID_USAGE_GENERIC_Z: controller->hid.rx_caps = *caps; break;
+    case HID_USAGE_GENERIC_RZ: controller->hid.ry_caps = *caps; break;
+    case HID_USAGE_GENERIC_RX: controller->hid.lt_caps = *caps; break;
+    case HID_USAGE_GENERIC_RY: controller->hid.rt_caps = *caps; break;
+    }
+    else switch (usage)
+    {
+    case HID_USAGE_GENERIC_X: controller->hid.lx_caps = *caps; break;
+    case HID_USAGE_GENERIC_Y: controller->hid.ly_caps = *caps; break;
