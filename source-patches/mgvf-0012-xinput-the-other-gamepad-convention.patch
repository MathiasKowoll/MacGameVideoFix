+/* MGVF mgvf-0012: a gamepad's six axes come in two conventions, and until now
+ * this file knew only one.
+ *
+ * The mapping below is the one Microsoft's own gamepad descriptor uses, and the
+ * one winexinput builds when it wraps a pad: X/Y for the left stick, Rx/Ry for
+ * the right, Z and Rz for the triggers. The other convention is at least as
+ * common -- every Sony pad follows it, and so do many others -- and puts the
+ * right stick on Z/Rz and the triggers on Rx/Ry.
+ *
+ * Read with the wrong one, a pad is not merely imprecise: a trigger at rest
+ * reads zero, and zero on an axis that is supposed to be centred is full
+ * deflection, so the right stick sits jammed in a corner and the game moves
+ * without being touched. Measured that way on a DualSense Edge, 2026-09-09.
+ *
+ * There is no rule in the descriptor that tells the two apart -- both spell the
+ * same six usages with the same logical ranges -- so, as SDL and the Linux
+ * drivers do, the pad is recognised by its vendor. */
 static void check_value_caps(struct xinput_controller *controller, USHORT usage, HIDP_VALUE_CAPS *caps)
 {
-    switch (usage)
+    /* The hat is read the same way whatever the convention; what changes is the
