+     * safer packet stays the default and the experiment is the thing that has
+     * to be asked for. */
+    const unsigned char no_button[] =
+    {
+        USAGE_PAGE(1, HID_USAGE_PAGE_GENERIC),
+        USAGE(1, HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER),
+        COLLECTION(1, Application),
+            REPORT_ID(1, input_id),
+            USAGE_PAGE(2, HID_USAGE_PAGE_VENDOR_DEFINED_BEGIN),
+            USAGE(1, 0x20),
+            LOGICAL_MINIMUM(1, 0),
+            LOGICAL_MAXIMUM(2, 0x00ff),
+            REPORT_SIZE(1, 8),
+            REPORT_COUNT(1, 1),
+            INPUT(1, Data|Var|Abs),
+            REPORT_SIZE(1, 8),
+            REPORT_COUNT(1, 1),
+            INPUT(1, Cnst|Var|Abs),
+    };
+
+    if (with_button)
+    {
+        if (out_size < sizeof(head)) return 0;
+        memcpy(out, head, sizeof(head));
+        return sizeof(head);
+    }
+    if (out_size < sizeof(no_button)) return 0;
+    memcpy(out, no_button, sizeof(no_button));
+    return sizeof(no_button);
