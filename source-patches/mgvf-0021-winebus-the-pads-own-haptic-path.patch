+     * haptic path, the one Sony's library uses on every packet. */
+    ext->haptics_path = get_device_option(ext->desc.vid, ext->desc.pid, L"XInputRumbleHapticPath", 0)
+                        ? DUALSENSE_VIBRATION_PATH_HAPTIC : DUALSENSE_VIBRATION_PATH_LEGACY;
