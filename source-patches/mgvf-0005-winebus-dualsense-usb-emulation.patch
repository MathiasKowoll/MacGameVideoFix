+ * a feature report from it, it sends a 10-byte 0x01 report instead. */
+#define DUALSENSE_BT_REPORT_ID     0x31
+#define DUALSENSE_BT_REPORT_LEN    78
+#define DUALSENSE_BT_SHORT_LEN     10
