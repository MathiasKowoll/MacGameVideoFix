+#define DUALSENSE_CRC_TAIL                 4
+#define DUALSENSE_CRC_SEED_OUTPUT          0xa2
+#define DUALSENSE_CRC_SEED_FEATURE_SET     0x53
+
+/* The USB report descriptor to present for a product id, or NULL when the
+ * table has no row for it; *length receives its size, 0 in that case. Both
+ * DualSense ids have one; anything else does not. */
+const unsigned char *dualsense_usb_report_descriptor(unsigned int pid, unsigned int *length);
+
+/* Each of these returns the number of bytes written to out, or 0 when the
+ * input is not the report it handles (wrong id or length) or out is too
