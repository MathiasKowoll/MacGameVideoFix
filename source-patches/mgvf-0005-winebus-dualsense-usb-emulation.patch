+ * descriptor was fetched and before the last-report buffers are sized from
+ * it. Nothing is swapped unless the new one parses. */
+static NTSTATUS dualsense_usb_replace_descriptors(DEVICE_OBJECT *device)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    HIDP_DEVICE_DESC collection_desc;
+    const unsigned char *desc;
