+    if (status != HIDP_STATUS_SUCCESS)
+    {
+        ERR("device %p: failed to parse the USB report descriptor for %04x:%04x, status %#lx\n",
+            device, ext->desc.vid, ext->desc.pid, status);
+        RtlFreeHeap(GetProcessHeap(), 0, copy);
+        return status;
+    }
+
+    TRACE("device %p: presenting the %u-byte USB report descriptor of %04x:%04x in place of the %u-byte Bluetooth one\n",
+          device, length, ext->desc.vid, ext->desc.pid, ext->report_desc_length);
+    HidP_FreeCollectionDescription(&ext->collection_desc);
+    RtlFreeHeap(GetProcessHeap(), 0, ext->report_desc);
+    ext->report_desc = copy;
+    ext->report_desc_length = length;
+    ext->collection_desc = collection_desc;
+    return STATUS_SUCCESS;
+}
+
+/* Read the calibration feature report once, which is what makes a paired pad
+ * stop sending its 10-byte 0x01 report and start sending 0x31: SDL and the
+ * Linux driver do the same when they open it. A wired pad sends 0x01/64 from
+ * the start, and a client that believes the pad is wired has no reason to
+ * read a feature report first. Synchronous, like any feature read a client
+ * makes. Failure is not fatal: the short reports are expanded as well. */
+static void dualsense_usb_kick(DEVICE_OBJECT *device)
+{
+    BYTE buffer[DUALSENSE_FEATURE_CALIBRATION_LEN] = {DUALSENSE_FEATURE_CALIBRATION};
+    HID_XFER_PACKET packet =
+    {
+        .reportId = DUALSENSE_FEATURE_CALIBRATION,
+        .reportBuffer = buffer,
+        .reportBufferLen = sizeof(buffer),
+    };
+    IO_STATUS_BLOCK io = {{0}};
+
+    unix_device_get_feature_report(device, &packet, &io);
+    if (io.Status)
+        WARN("device %p: reading feature report %#x failed, status %#lx; the pad may keep sending short input reports\n",
+             device, packet.reportId, io.Status);
+    else
+        TRACE("device %p: read feature report %#x (%Iu bytes) so the pad switches to full input reports\n",
+              device, packet.reportId, io.Information);
+}
+
+/* A USB 0x02 output report from the client becomes the Bluetooth 0x31 the
+ * pad wants, sent through a packet of our own; the client's IoStatus then
+ * reports the client's own length, as a wired write would. */
+static void dualsense_usb_set_output_report(DEVICE_OBJECT *device, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    BYTE buffer[DUALSENSE_BT_REPORT_LEN];
+    HID_XFER_PACKET bt = {.reportId = DUALSENSE_BT_REPORT_ID, .reportBuffer = buffer};
+    ULONG i;
+
+    if (!(bt.reportBufferLen = dualsense_bt_output_from_usb(buffer, sizeof(buffer), packet->reportBuffer,
+                                                            packet->reportBufferLen, ext->dualsense_seq,
+                                                            dualsense_crc32)))
+    {
+        WARN("output report id %u length %lu cannot be translated for Bluetooth\n",
+             packet->reportId, packet->reportBufferLen);
+        io->Status = STATUS_INVALID_PARAMETER;
+        io->Information = 0;
+        return;
+    }
+    ext->dualsense_seq++;
+
+    if (TRACE_ON(hid))
+    {
+        TRACE("translated output report id %u length %lu to id %u length %lu:\n", packet->reportId,
+              packet->reportBufferLen, bt.reportId, bt.reportBufferLen);
+        for (i = 0; i < bt.reportBufferLen;)
+        {
+            char line[256], *buf = line;
+            buf += sprintf(buf, "%08lx ", i);
+            do { buf += sprintf(buf, " %02x", bt.reportBuffer[i]); }
+            while (++i % 16 && i < bt.reportBufferLen);
+            TRACE("%s\n", line);
+        }
+    }
+
+    unix_device_set_output_report(device, &bt, io);
+    if (!io->Status) io->Information = packet->reportBufferLen;
+}
+
+/* A feature report written by the client goes to the pad with the CRC it
+ * checks over Bluetooth in its last four bytes, from a copy: the client's
+ * buffer is not ours to rewrite. */
+static void dualsense_usb_set_feature_report(DEVICE_OBJECT *device, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    BYTE buffer[256];
+    HID_XFER_PACKET bt = {.reportId = packet->reportId, .reportBuffer = buffer, .reportBufferLen = packet->reportBufferLen};
+
+    if (packet->reportBufferLen > sizeof(buffer) || packet->reportBufferLen <= DUALSENSE_CRC_TAIL)
+    {
+        WARN("feature report id %u length %lu has no room for a CRC, forwarding it unchanged\n",
+             packet->reportId, packet->reportBufferLen);
+        unix_device_set_feature_report(device, packet, io);
+        return;
+    }
+
+    memcpy(buffer, packet->reportBuffer, packet->reportBufferLen);
+    dualsense_bt_feature_set_crc(buffer, packet->reportBufferLen, dualsense_crc32);
+    TRACE("appended the Bluetooth CRC to feature report id %u length %lu: %02x %02x %02x %02x\n",
+          packet->reportId, packet->reportBufferLen, buffer[packet->reportBufferLen - 4],
+          buffer[packet->reportBufferLen - 3], buffer[packet->reportBufferLen - 2], buffer[packet->reportBufferLen - 1]);
+    unix_device_set_feature_report(device, &bt, io);
+}
+
+/* A feature report read from the pad carries its CRC in the last four bytes
+ * of the report -- the report's declared length, not the client's buffer,
+ * which hidclass passes through as large as the client made it -- and a
+ * wired pad has zeros there, the calibration report excepted; dualsense_usb.c
+ * says which reads that was measured on. */
+static void dualsense_usb_feature_get_fixup(DEVICE_OBJECT *device, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    ULONG len = get_feature_report_length(ext, packet->reportId);
+
+    if (!len || len > packet->reportBufferLen) len = io->Information;
+    if (len > packet->reportBufferLen) len = packet->reportBufferLen;
+    if (dualsense_bt_feature_get_strip(packet->reportBuffer, len))
+        TRACE("zeroed the Bluetooth CRC tail of feature report id %u (%lu bytes)\n", packet->reportId, len);
+}
