+/* One row per product id that can be presented; both DualSense ids are here,
+ * each with the descriptor read from that pad on a cable. A pid with no row
+ * gets NULL back, and the option is refused for it rather than answered with
+ * a descriptor derived from another pad's -- which is what the "ProductId"
+ * override is checked against before it is honoured.
+ *
+ * A third pad -- a DualShock 4, say -- would need more than a row: its
+ * descriptor, its input reports and its output reports all differ from a
+ * DualSense's, so it would be a second translation layer, and nothing
+ * measured asks for one. */
+struct dualsense_usb_descriptor
+{
+    unsigned int pid;
+    const unsigned char *data;
+    unsigned int length;
+};
+
+static const struct dualsense_usb_descriptor dualsense_usb_descriptors[] =
+{
+    {DUALSENSE_EDGE_PID, dualsense_edge_usb_report_desc, sizeof(dualsense_edge_usb_report_desc)},
+    {DUALSENSE_PID, dualsense_usb_report_desc, sizeof(dualsense_usb_report_desc)},
+};
+
+const unsigned char *dualsense_usb_report_descriptor(unsigned int pid, unsigned int *length)
+{
+    unsigned int i;
+
+    for (i = 0; i < sizeof(dualsense_usb_descriptors) / sizeof(dualsense_usb_descriptors[0]); i++)
+    {
+        if (dualsense_usb_descriptors[i].pid != pid) continue;
+        if (!dualsense_usb_descriptors[i].data) break;
+        *length = dualsense_usb_descriptors[i].length;
+        return dualsense_usb_descriptors[i].data;
+    }
+
+    *length = 0;
+    return NULL;
+}
+
+/* The Bluetooth 0x31 input report is the USB 0x01 report with one byte in
+ * front (after the id: a sequence byte), nine reserved bytes behind and the
+ * CRC after those:
+ *
+ *   USB 0x01/64:  id  X Y Z Rz L2 R2 seq buttons[3] ...   (63 data bytes)
+ *   BT  0x31/78:  id  hdr  X Y Z Rz L2 R2 seq buttons[3] ... [9 bytes] CRC[4]
+ *
+ * so the USB report is the 63 bytes after the header, verbatim. The pad's own
+ * CRC over the input (seed 0xa1) is not checked here; SDL and the Linux
+ * driver do, and a report that fails it would be dropped there. */
+unsigned int dualsense_usb_input_from_bt(unsigned char *out, unsigned int out_size,
+                                         const unsigned char *in, unsigned int in_len)
+{
+    if (in_len < 2 + DUALSENSE_USB_INPUT_LEN - 1 || in[0] != DUALSENSE_BT_REPORT_ID) return 0;
+    if (out_size < DUALSENSE_USB_INPUT_LEN) return 0;
+
+    out[0] = DUALSENSE_USB_INPUT_ID;
+    memcpy(out + 1, in + 2, DUALSENSE_USB_INPUT_LEN - 1);
+    return DUALSENSE_USB_INPUT_LEN;
+}
+
+/* Before any feature report has been read from it, a paired pad sends a
+ * 10-byte report 0x01 -- the layout stock winebus produces from a 0x31 for
+ * its Bluetooth fixup, and the one this reverses:
+ *
+ *   BT  0x01/10:  id  X Y Z Rz buttons[3] L2 R2
+ *   USB 0x01/64:  id  X Y Z Rz L2 R2 seq buttons[3] ... zeros
+ *
+ * The short report carries no sequence byte, so byte 7 is 0, and none of the
+ * touchpad, motion or battery data, so the rest is zero: a client sees the
+ * sticks, triggers and buttons, and nothing else moving, until the pad
+ * switches over. */
+unsigned int dualsense_usb_input_from_short(unsigned char *out, unsigned int out_size,
+                                            const unsigned char *in, unsigned int in_len)
+{
+    if (in_len != DUALSENSE_BT_SHORT_LEN || in[0] != DUALSENSE_USB_INPUT_ID) return 0;
+    if (out_size < DUALSENSE_USB_INPUT_LEN) return 0;
+
+    memset(out, 0, DUALSENSE_USB_INPUT_LEN);
+    out[0] = DUALSENSE_USB_INPUT_ID;
+    out[1] = in[1]; /* X */
+    out[2] = in[2]; /* Y */
+    out[3] = in[3]; /* Z */
+    out[4] = in[4]; /* Rz */
+    out[5] = in[8]; /* L2 */
+    out[6] = in[9]; /* R2 */
+    out[7] = 0;     /* sequence: the short report has none */
+    out[8] = in[5]; /* buttons[0] */
+    out[9] = in[6]; /* buttons[1] */
+    out[10] = in[7]; /* buttons[2] */
+    return DUALSENSE_USB_INPUT_LEN;
+}
+
+static void dualsense_store_crc(unsigned char *tail, unsigned int crc)
+{
+    tail[0] = crc & 0xff;
+    tail[1] = (crc >> 8) & 0xff;
+    tail[2] = (crc >> 16) & 0xff;
+    tail[3] = (crc >> 24) & 0xff;
+}
