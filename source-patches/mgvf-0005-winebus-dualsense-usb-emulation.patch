+/* The USB 0x02 output report becomes a Bluetooth 0x31:
+ *
+ *   USB 0x02/N:   id  data[N-1]                                     (N = 48 or 64)
+ *   BT  0x31/78:  id  seq<<4  0x10  data[N-1] zeros...  CRC[4] at 74..77
+ *
+ * Byte 1 carries a 4-bit sequence number in its high nibble; the pad accepts
+ * a constant one (Steam sends 0 every time) as well as a counting one (the
+ * Linux driver counts), so the caller passes whatever it keeps. Byte 2 is
+ * 0x10, the flag that marks the report as carrying the effects block.
+ * The CRC runs over the seed byte 0xa2 and then bytes 0..73. Verified byte
+ * for byte, CRC included, against Steam's own packets and against a packing
+ * that rumbled the pad through IOKit. */
+unsigned int dualsense_bt_output_from_usb(unsigned char *out, unsigned int out_size,
+                                          const unsigned char *in, unsigned int in_len,
+                                          unsigned char seq, dualsense_crc32_fn crc32)
+{
+    static const unsigned char seed = DUALSENSE_CRC_SEED_OUTPUT;
+    unsigned int crc;
+
+    if (in_len < 2 || in_len > DUALSENSE_USB_OUTPUT_MAX || in[0] != DUALSENSE_USB_OUTPUT_ID) return 0;
+    if (out_size < DUALSENSE_BT_REPORT_LEN) return 0;
+
+    memset(out, 0, DUALSENSE_BT_REPORT_LEN);
+    out[0] = DUALSENSE_BT_REPORT_ID;
+    out[1] = (seq & 0x0f) << 4;
+    out[2] = 0x10;
+    memcpy(out + 3, in + 1, in_len - 1);
+
+    crc = crc32(0, &seed, 1);
+    crc = crc32(crc, out, DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL);
+    dualsense_store_crc(out + DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL, crc);
+    return DUALSENSE_BT_REPORT_LEN;
+}
+
+/* A feature report written over Bluetooth ends in a CRC-32 the pad checks,
+ * seed byte 0x53, over everything before it. The reports that exist in both
+ * descriptors have the same length in both, so the tail of the USB-length
+ * report is exactly where the pad looks. libScePad's own Bluetooth path
+ * writes feature 0x08 this way, and a failed write of it is fatal to its
+ * reader thread -- which is why the CRC is appended rather than left to the
+ * caller. */
+unsigned int dualsense_bt_feature_set_crc(unsigned char *report, unsigned int len, dualsense_crc32_fn crc32)
+{
+    static const unsigned char seed = DUALSENSE_CRC_SEED_FEATURE_SET;
+    unsigned int crc;
+
+    if (len <= DUALSENSE_CRC_TAIL) return 0;
+
+    crc = crc32(0, &seed, 1);
+    crc = crc32(crc, report, len - DUALSENSE_CRC_TAIL);
+    dualsense_store_crc(report + len - DUALSENSE_CRC_TAIL, crc);
+    return len;
+}
+
+/* A feature report read over Bluetooth ends in the pad's CRC-32 of it, seed
+ * byte 0xa3, and a wired pad returns zeros in those four bytes: measured on
+ * the pairing-info report 0x09 and the firmware report 0x20, which the same
+ * pad returned byte-identical over both transports except for that tail.
+ * Zeroing it makes the read look wired.
+ *
+ * The calibration report 0x05 is the exception and is left alone: the wired
+ * pad returned it with the CRC in place, the same 41 bytes as over Bluetooth,
+ * so there the CRC is part of what a wired pad's client sees. No other
+ * feature report has been read from the wired pad; those get the rule. */
+unsigned int dualsense_bt_feature_get_strip(unsigned char *report, unsigned int len)
+{
+    if (len <= DUALSENSE_CRC_TAIL) return 0;
+    if (report[0] == DUALSENSE_FEATURE_CALIBRATION) return 0;
+
+    memset(report + len - DUALSENSE_CRC_TAIL, 0, DUALSENSE_CRC_TAIL);
+    return len;
+}
