+unsigned int dualsense_bt_output_from_usb(unsigned char *out, unsigned int out_size,
+                                          const unsigned char *in, unsigned int in_len,
+                                          unsigned char seq, dualsense_crc32_fn crc32);
+
+/* In place. Each returns len when the report was changed and 0 when it was
