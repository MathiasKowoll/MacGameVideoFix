+/* MGVF mgvf-0009: the two vibration options, read as the device arrives.
+ *
+ * READ BEFORE dualsense_usb_emulation_fixups, for the reason mgvf-0008 gives
+ * for reading ForwardFeatureWrites where it does: "ProductId" can replace the
+ * pid in the desc with another DualSense's, and a read after that would look
+ * for this pad's options under the other pad's key.
+ *
+ * Scoped to a hidraw DualSense that arrived over Bluetooth, which is the only
+ * device whose output reports either hook below touches, and left at all zeros
+ * for everything else. Unlike SeizeDevice this is OFF by default: it changes
+ * what a game asked for, which is a preference and not a repair, and the
+ * evidence for it is one person's hand.
+ *
+ * @@ Wine registry key: HKLM\System\CurrentControlSet\Services\WineBus\Devices\<VID/PID>
+ */
+static void dualsense_vibration_options(const struct device_desc *desc, struct dualsense_vibration *vib)
+{
+    memset(vib, 0, sizeof(*vib));
+
+    if (!desc->is_hidraw || desc->bus_type != BUS_TYPE_BLUETOOTH) return;
+    if (!is_dualsense_gamepad(desc->vid, desc->pid)) return;
+
+    vib->mode = get_device_option(desc->vid, desc->pid, L"VibrationMode", DUALSENSE_VIBRATION_MODE_CLIENT);
+    vib->gain = get_device_option(desc->vid, desc->pid, L"VibrationGain", 100);
+    if (vib->gain > DUALSENSE_VIBRATION_GAIN_MAX) vib->gain = DUALSENSE_VIBRATION_GAIN_MAX;
+
+    /* Nothing asked for is stored as nothing at all, so that "the options are
+     * all zero" is the one test the write path has to make. An absent
+     * VibrationGain reads as 100 above and lands here; a gain written as 0
+     * does not, because 0 is a request -- silence -- and not an absence. */
+    if (vib->mode == DUALSENSE_VIBRATION_MODE_CLIENT && vib->gain == 100)
+    {
+        memset(vib, 0, sizeof(*vib));
+        return;
+    }
+
+    TRACE("DualSense %04x:%04x on Bluetooth: output reports will be rewritten -- %s, gain %u%%\n",
+          desc->vid, desc->pid, vib->mode == DUALSENSE_VIBRATION_MODE_LEGACY ?
+          "the haptic path becomes the legacy compatible motors" : "the client's own mode is kept", vib->gain);
+}
