+/* MGVF mgvf-0009: rewrite the vibration of a packed 0x31 on its way to the pad,
+ * and say in one line what was done to it.
+ *
+ * Both routes end here, which is the point: the title this was measured on
+ * writes report 0x31 itself with no emulation in the way, so a hook that lived
+ * only in the emulation path would never see the packets it was written for.
+ * dualsense_usb.c does the rewrite and computes the CRC again -- a 0x31 whose
+ * CRC does not cover its bytes is one the pad ignores.
+ *
+ * TRACE and not WARN, as mgvf-0007's line is: with the option on this fires on
+ * every packet that asks for a motor, hundreds of times in a session, and it is
+ * what the option is for rather than something going wrong. The line carries
+ * both halves of everything it touched, because the next trace has to show
+ * plainly what was changed and what was left. */
+static BOOL dualsense_vibration_fixup(DEVICE_OBJECT *device, BYTE reportId, BYTE *report, ULONG len)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    struct dualsense_vibration_change change;
+
+    if (!dualsense_bt_vibration_fixup(report, len, &ext->dualsense_vibration, dualsense_crc32, &change)) return FALSE;
+
+    TRACE("device %p: rewrote the vibration in output report id %u -- mode flag0 %#x -> %#x, flag2 %#x -> %#x"
+          " (%s), motors %u/%u -> %u/%u\n", device, reportId, change.flag0_before, change.flag0_after,
+          change.flag2_before, change.flag2_after,
+          (change.flag2_before != change.flag2_after) ? "the haptic path becomes the legacy compatible motors" :
+          "the mode is the client's own", change.motor_right_before, change.motor_left_before,
+          change.motor_right_after, change.motor_left_after);
+    return TRUE;
+}
+
+/* MGVF mgvf-0009: a client that knows the pad is on Bluetooth and writes the
+ * pad's own 0x31 itself -- which is what the Unreal title in
+ * steam-hid-game-145815.log does for all 6493 of its output reports. Nothing is
+ * emulated here and nothing is translated; the packet is already what the pad
+ * wants, and all that happens is the rewrite, in a copy, because the client's
+ * buffer is not ours to change. A packet the options have nothing to say about
+ * is forwarded as the client wrote it, from the client's own buffer. */
+static void dualsense_bt_set_output_report(DEVICE_OBJECT *device, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io)
+{
+    BYTE buffer[DUALSENSE_BT_REPORT_LEN];
+    HID_XFER_PACKET bt = {.reportId = packet->reportId, .reportBuffer = buffer,
+                          .reportBufferLen = DUALSENSE_BT_REPORT_LEN};
+
+    memcpy(buffer, packet->reportBuffer, DUALSENSE_BT_REPORT_LEN);
+    if (dualsense_vibration_fixup(device, packet->reportId, buffer, DUALSENSE_BT_REPORT_LEN))
+        unix_device_set_output_report(device, &bt, io);
+    else
+        unix_device_set_output_report(device, packet, io);
+}
