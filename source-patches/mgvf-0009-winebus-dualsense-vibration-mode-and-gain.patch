+/* MGVF mgvf-0009: a stronger rumble, and a way to ask for more of it.
+ *
+ * WHAT WAS MEASURED. steam-hid-game-145815.log, a two-hour Bluetooth session of
+ * an Unreal title that drives the pad through Unreal's WinDualShock, presented
+ * truthfully and with no emulation involved: 6493 output reports of id 0x31,
+ * every one of them 78 bytes and written by the title itself. 335 of those
+ * carry a non-zero motor byte, and they reach the full 255 -- 36 packets at
+ * right 255 with the left motor at rest, 18 at 255 and 255 together. ALL 335
+ * CARRY THE SAME MODE: first flag byte 0x02, second 0x00, common byte 38 0x04.
+ * So the game is not asking for a weak effect. It is asking for full strength
+ * on the haptic path.
+ *
+ * WHAT THE TWO PATHS ARE. SDL 2.30.12's SDL_hidapi_ps5.c, read from the copy in
+ * this build directory, lays the same block out field for field --
+ * ucEnableBits1 at 0, ucRumbleRight at 2, ucRumbleLeft at 3, ucEnableBits3 at
+ * 38 -- and chooses between two ways of driving the motors by the pad's
+ * firmware version: below 2.24 it sets ucEnableBits1 bit 0x01, which its own
+ * comment calls "Enable rumble emulation", and HALVES both motor bytes there,
+ * "to reduce effective rumble strength to match Xbox controllers"; at 2.24 and
+ * above it sets ucEnableBits3 bit 0x04, "Enable improved rumble emulation", and
+ * sends the motor values unhalved. Both branches also set ucEnableBits1 bit
+ * 0x02, "Disable audio haptics". The mode in the log is the second of those,
+ * bit for bit.
+ *
+ * WHY THAT IS WORTH CHANGING, AND HOW WEAK THE EVIDENCE IS. The owner compared
+ * the two paths directly on the pad with a six-pulse ladder -- dsrumble3.c,
+ * which sends this exact packet through IOKit at 255 and at 127 in three
+ * modes: legacy (flag0 0x01|0x02), the haptic path (flag0 0x02, byte 38 0x04),
+ * and both bits at once -- and reported that LEGACY COMPATIBLE VIBRATION AT 255
+ * FEELS CLEARLY STRONGER than the haptic mode at 255, and that the haptic mode
+ * at 127 is what the game feels like. THAT PERCEPTION IS THE EVIDENCE FOR THIS
+ * PATCH. It is a preference, measured on one person's hand, not a physical
+ * measurement of anything: no accelerometer, no current draw, no repetition
+ * blind. It is why the rewrite is OFF unless a registry value asks for it.
+ *
+ * WHICH BIT IS CLEARED, WHICH IS SET, AND WHY EACH.
+ *
+ *   SET flag0 bit 0x01. That is the bit SDL sets when it wants the motors
+ *   driven the legacy way, and the bit the owner's mode A set for the pulse he
+ *   preferred. Set rather than assigned, so the rest of the byte survives.
+ *
+ *   CLEAR byte 38 bit 0x04. That is the bit SDL sets for the other path and the
+ *   only bit of that byte the measured packets carry (their byte 38 is exactly
+ *   0x04). Leaving it set would ask the pad for both at once, which is the
+ *   ladder's mode C -- a third thing, not the one that was preferred.
+ *
+ *   LEAVE flag0 bit 0x02 ALONE. SDL sets it on BOTH paths, so it is not the
+ *   choice between them, and all three of the ladder's modes carried it. What
+ *   it does -- SDL calls it "Disable audio haptics" -- is not this patch's
+ *   business.
+ *
+ *   LEAVE EVERY OTHER BYTE ALONE, the second flag byte included, for the reason
+ *   mgvf-0007 leaves it alone: nothing measured says what its other bits mean.
+ *
+ * THE MOTOR BYTES ARE NOT SCALED BY THE MODE REWRITE. SDL halves them on the
+ * legacy path; this does not, deliberately, because halving them is the thing
+ * that would undo what the ladder found -- the ladder sent the SAME value on
+ * both paths and the legacy one felt stronger. VibrationGain is the separate,
+ * explicit way to change the number.
+ *
+ * WHAT IS NOT ESTABLISHED. Why the two paths feel different -- whether the pad
+ * drives different actuators, or the same ones differently, or whether the
+ * firmware of this particular pad simply implements one better. Nothing here
+ * measures the pad's firmware version either, so which path Sony intended for
+ * it is unknown. And no title has yet been played with the rewrite on: what is
+ * measured is the ladder, by hand, and the corpus the mode came out of. */
+static unsigned char dualsense_scale_motor(unsigned char motor, unsigned int gain)
+{
+    unsigned int scaled;
+
+    if (!motor) return motor;
+    scaled = ((unsigned int)motor * gain) / 100;
+    return scaled > 255 ? 255 : (unsigned char)scaled;
+}
+
+/* The rewrite itself, over the common block of a packed 0x31. Returns non-zero
+ * when it changed a byte.
+ *
+ * The gain is applied only to a packet that actually SELECTED a way to
+ * vibrate -- legacy or haptic, after the mode rewrite above has had its say --
+ * because a motor byte with neither bit set is a byte the pad ignores, and
+ * mgvf-0007's rule holds here too: what is acted on is the request, not the
+ * bytes. It truncates rather than rounds, so 89 at 150% is 133 and not 134,
+ * and it saturates: a game already asking for 255 cannot be made to ask for
+ * more, which is the honest limit of a gain and is why this is not a way to
+ * make a quiet game loud.
+ *
+ * A gain of 0 is the other end of the same dial and is a request like any
+ * other: every motor byte becomes 0 and the pad never buzzes, whatever the
+ * game asks for and whether or not the game has a setting of its own. It is
+ * not the same as no gain at all -- an absent value reads as 100 and this
+ * function is never reached. */
+static unsigned char dualsense_vibration_rewrite(unsigned char *common, const struct dualsense_vibration *vib,
+                                                 struct dualsense_vibration_change *change)
+{
+    unsigned char changed = 0, right, left;
+    unsigned int gain = vib->gain;
+
+    if (change)
+    {
+        memset(change, 0, sizeof(*change));
+        change->flag0_before = change->flag0_after = common[DUALSENSE_COMMON_FLAG0];
+        change->flag2_before = change->flag2_after = common[DUALSENSE_COMMON_FLAG2];
+        change->motor_right_before = change->motor_right_after = common[DUALSENSE_COMMON_MOTOR_RIGHT];
+        change->motor_left_before = change->motor_left_after = common[DUALSENSE_COMMON_MOTOR_LEFT];
+    }
+
+    if (vib->mode == DUALSENSE_VIBRATION_MODE_LEGACY
+        && (common[DUALSENSE_COMMON_FLAG2] & DUALSENSE_FLAG2_HAPTIC_VIBRATION))
+    {
+        common[DUALSENSE_COMMON_FLAG2] &= ~DUALSENSE_FLAG2_HAPTIC_VIBRATION;
+        common[DUALSENSE_COMMON_FLAG0] |= DUALSENSE_FLAG0_LEGACY_VIBRATION;
+        changed = 1;
+    }
+
+    if (gain > DUALSENSE_VIBRATION_GAIN_MAX) gain = DUALSENSE_VIBRATION_GAIN_MAX;
+    if (gain != 100
+        && ((common[DUALSENSE_COMMON_FLAG0] & DUALSENSE_FLAG0_LEGACY_VIBRATION)
+            || (common[DUALSENSE_COMMON_FLAG2] & DUALSENSE_FLAG2_HAPTIC_VIBRATION)))
+    {
+        right = dualsense_scale_motor(common[DUALSENSE_COMMON_MOTOR_RIGHT], gain);
+        left = dualsense_scale_motor(common[DUALSENSE_COMMON_MOTOR_LEFT], gain);
+        if (right != common[DUALSENSE_COMMON_MOTOR_RIGHT] || left != common[DUALSENSE_COMMON_MOTOR_LEFT])
+        {
+            common[DUALSENSE_COMMON_MOTOR_RIGHT] = right;
+            common[DUALSENSE_COMMON_MOTOR_LEFT] = left;
+            changed = 1;
+        }
+    }
+
+    if (change)
+    {
+        change->changed = changed;
+        change->flag0_after = common[DUALSENSE_COMMON_FLAG0];
+        change->flag2_after = common[DUALSENSE_COMMON_FLAG2];
+        change->motor_right_after = common[DUALSENSE_COMMON_MOTOR_RIGHT];
+        change->motor_left_after = common[DUALSENSE_COMMON_MOTOR_LEFT];
+    }
+
+    return changed;
 }
 
+/* MGVF mgvf-0009: the entry point both routes use.
+ *
+ * The CRC is computed again over the rewritten bytes, and that is not a detail:
+ * the pad checks it and drops a 0x31 whose four trailing bytes do not cover the
+ * report. The title measured above writes its own 0x31 with its own CRC, so
+ * rewriting a byte without re-signing would take its rumble away entirely
+ * rather than change it.
+ *
+ * Nothing is written when nothing is asked for, and the caller can tell: a
+ * return of 0 means the client's own buffer is still the right thing to send. */
+unsigned int dualsense_bt_vibration_fixup(unsigned char *report, unsigned int len,
+                                          const struct dualsense_vibration *vib,
+                                          dualsense_crc32_fn crc32,
+                                          struct dualsense_vibration_change *change)
+{
+    static const unsigned char seed = DUALSENSE_CRC_SEED_OUTPUT;
+    unsigned int crc;
+
+    if (len != DUALSENSE_BT_REPORT_LEN || report[0] != DUALSENSE_BT_REPORT_ID) return 0;
+    if (vib->mode == DUALSENSE_VIBRATION_MODE_CLIENT && vib->gain == 100) return 0;
+    if (!dualsense_vibration_rewrite(report + DUALSENSE_BT_COMMON, vib, change)) return 0;
+
+    crc = crc32(0, &seed, 1);
+    crc = crc32(crc, report, DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL);
+    dualsense_store_crc(report + DUALSENSE_BT_REPORT_LEN - DUALSENSE_CRC_TAIL, crc);
+    return len;
+}
