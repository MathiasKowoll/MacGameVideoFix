+
+static void dualsense_usb_set_output_report(DEVICE_OBJECT *device, HID_XFER_PACKET *packet, IO_STATUS_BLOCK *io);
+
+/* MGVF mgvf-0010: the motors are written from here, never from the caller.
+ *
+ * Sending a pair of motor levels is a synchronous write to the device, and over
+ * Bluetooth it takes milliseconds. Doing it on the thread that asked -- which is
+ * the thread drawing the game -- cost Beast HALF ITS FRAME RATE, and rationing
+ * it to sixteen writes a second still cost five, which in a game where a frame
+ * decides a parry is not a rounding error.
+ *
+ * So the request costs nothing: the caller leaves the levels in `wanted` and is
+ * answered. This thread wakes, takes whatever is there NOW and writes it. That
+ * coalescing is the useful part -- everything asked for while a write was in
+ * flight collapses into the one value that is still true when the link is free
+ * again, which is exactly what a motor should be told.
+ *
+ * The interval below is a floor on how often the link is used, not a way of
+ * protecting the game any more; the game is already out of the way. */
+static DWORD CALLBACK dualsense_haptics_thread(void *arg)
+{
+    DEVICE_OBJECT *device = arg;
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    HANDLE waits[2] = {ext->haptics_stop, ext->haptics_wake};
+    LONG last = -1;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_winebus_dualsense_haptics");
+
+    for (;;)
+    {
+        BYTE motors[DUALSENSE_USB_OUTPUT_MAX];
+        HID_XFER_PACKET out = {.reportId = DUALSENSE_HAPTICS_MOTOR_REPORT_ID, .reportBuffer = motors};
+        IO_STATUS_BLOCK io = {{0}};
+        LARGE_INTEGER started, ended;
+        unsigned int rumble, buzz;
+        ULONG length;
+        LONG wanted;
+
+        if (WaitForMultipleObjects(2, waits, FALSE, INFINITE) == WAIT_OBJECT_0) break;
+
+        wanted = InterlockedCompareExchange(&ext->haptics_wanted, 0, 0);
+        if (wanted == last) continue;
+        last = wanted;
+
+        rumble = ((unsigned int)wanted >> 16) & 0xffff;
+        buzz = (unsigned int)wanted & 0xffff;
+
+        length = get_output_report_length(ext, DUALSENSE_HAPTICS_MOTOR_REPORT_ID);
+        if (!length && ext->desc.bus_type == BUS_TYPE_BLUETOOTH)
+            length = DUALSENSE_HAPTICS_MOTOR_REPORT_LEN;
+        /* On Bluetooth the packet goes through mgvf-0009's rewrite on its way
+         * out and the preference is applied there; applying it here as well
+         * would apply it twice. On a cable nothing downstream does, so it is
+         * applied here -- which is the only reason this parameter exists. */
+        if (!length || !(out.reportBufferLen = dualsense_haptics_motor_report(motors, sizeof(motors), length,
+                                                                             rumble, buzz,
+                                                                             ext->desc.bus_type == BUS_TYPE_BLUETOOTH
+                                                                             ? 100 : ext->haptics_gain)))
+        {
+            WARN("device %p: no output report %#x of a usable length to carry the motors\n",
+                 device, DUALSENSE_HAPTICS_MOTOR_REPORT_ID);
+            continue;
+        }
+
+        TRACE("device %p: telling the motors rumble %u, buzz %u\n", device, rumble, buzz);
+
+        /* How long the write itself takes, because the interval above is only
+         * a floor: if a write costs more than the floor, the floor does
+         * nothing and every value below it behaves the same. Measuring that is
+         * the difference between choosing a number and guessing one. */
+        KeQuerySystemTime(&started);
+
+        /* The report is built in the pad's USB shape whatever the transport,
+         * because that is the shape the rest of this driver delivers: on a
+         * cable it goes down as it is, and over Bluetooth mgvf-0005's
+         * translation packs it into a 0x31, signs it, and mgvf-0009's
+         * preferences are applied on the way -- so what a client asked of the
+         * motors here is scaled by the same percentage as what a client asks
+         * of them itself. */
+        if (ext->desc.bus_type == BUS_TYPE_BLUETOOTH)
+            dualsense_usb_set_output_report(device, &out, &io);
+        else
+            unix_device_set_output_report(device, &out, &io);
+
+        KeQuerySystemTime(&ended);
+        TRACE("device %p: the write took %u ms\n", device,
+              (unsigned int)((ended.QuadPart - started.QuadPart) / 10000));
+
+        /* A floor on how often the link is used. Anything asked for in the
+         * meantime is still in `wanted` and goes out on the next turn, so
+         * nothing is lost by waiting here -- only coalesced. */
+        if (ext->haptics_interval)
+            WaitForSingleObject(ext->haptics_stop, (DWORD)(ext->haptics_interval / 10000ull));
+    }
+
+    return 0;
 }
 
