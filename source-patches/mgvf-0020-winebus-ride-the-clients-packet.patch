+ * dualsense_vibration_fixup runs on the copy afterwards and scales the stamped
+ * pair exactly as it scales the thread's Bluetooth packets, so the two writers
+ * cannot drift apart on that either. */
+static BOOL dualsense_bt_ride(DEVICE_OBJECT *device, BYTE *report)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    unsigned int moved_r, moved_l;
+    unsigned char r, l;
