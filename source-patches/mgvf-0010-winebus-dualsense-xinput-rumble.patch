                     TRACE("%s\n", buffer);
                 }
             }
+            /* MGVF mgvf-0010: an intensity written to the haptics collection.
+             *
+             * FOR NOW IT IS ONLY READ. This step of the work exists to answer
+             * one question on a real pad and a real game -- does offering the
+             * collection cost anything the pad already did? -- and moving the
+             * motors as well would answer two at once and tell us which. The
+             * write is completed as a success, as the descriptor promises, and
+             * the trace says what was asked for, so a game can be watched
+             * driving the motors before a single byte reaches the pad.
+             *
+             * hidraw_disable_report_fixups is deliberately NOT called on this
+             * path: it exists to notice that a client is writing the pad's own
+             * reports, and this report is not the pad's. */
+            if (ext->haptics_output_id && packet->reportId == ext->haptics_output_id)
+            {
+                unsigned int rumble = 0, buzz = 0;
+                BYTE motors[DUALSENSE_USB_OUTPUT_MAX];
+                HID_XFER_PACKET out = {.reportId = DUALSENSE_HAPTICS_MOTOR_REPORT_ID, .reportBuffer = motors};
+                ULONG length = get_output_report_length(ext, DUALSENSE_HAPTICS_MOTOR_REPORT_ID);
+                ULONG asked = packet->reportBufferLen;
+
+                /* Over Bluetooth the pad declares no output report 0x02 -- its
+                 * own outputs are 0x31 and up -- and asking the descriptor for
+                 * one there refused every write. Nothing of that shape is ever
+                 * sent on that transport anyway: it is only what the
+                 * translation below packs into a 0x31. */
+                if (!length && ext->desc.bus_type == BUS_TYPE_BLUETOOTH)
+                    length = DUALSENSE_HAPTICS_MOTOR_REPORT_LEN;
+
+                if (!dualsense_haptics_output_levels(packet->reportBuffer, asked,
+                                                     ext->haptics_output_id, &rumble, &buzz))
+                {
+                    WARN("device %p: a haptics write of %lu bytes is too short to read\n", device, asked);
+                    irp->IoStatus.Status = STATUS_INVALID_PARAMETER;
+                    irp->IoStatus.Information = 0;
+                    break;
+                }
+
+                TRACE("device %p: xinput asks for rumble %u, buzz %u\n", device, rumble, buzz);
+
+                if (!length || !(out.reportBufferLen = dualsense_haptics_motor_report(motors, sizeof(motors),
+                                                                                     length, rumble, buzz)))
+                {
+                    WARN("device %p: no output report %#x of a usable length to carry the motors\n",
+                         device, DUALSENSE_HAPTICS_MOTOR_REPORT_ID);
+                    irp->IoStatus.Status = STATUS_INVALID_PARAMETER;
+                    irp->IoStatus.Information = 0;
+                    break;
+                }
+
+                /* The report is built in the pad's USB shape whatever the
+                 * transport, because that is the shape the rest of this driver
+                 * delivers: on a cable it goes down as it is, and over
+                 * Bluetooth mgvf-0005's translation packs it into a 0x31, signs
+                 * it, and mgvf-0009's preferences are applied to it on the way
+                 * -- so what a client asked of the motors here is scaled by the
+                 * same percentage as what a client asks of them itself. */
+                if (ext->desc.bus_type == BUS_TYPE_BLUETOOTH)
+                    dualsense_usb_set_output_report(device, &out, &irp->IoStatus);
+                else
+                    unix_device_set_output_report(device, &out, &irp->IoStatus);
+
+                /* The client wrote the haptics report and is owed that report's
+                 * length, not the length of what the pad was actually sent. */
+                if (!irp->IoStatus.Status) irp->IoStatus.Information = asked;
+                break;
+            }
             /* MGVF mgvf-0005: the USB 0x02 goes out as a Bluetooth 0x31 */
             if ((ext->report_fixups & HIDRAW_FIXUP_DUALSENSE_USB) && packet->reportId == DUALSENSE_USB_OUTPUT_ID)
                 dualsense_usb_set_output_report(device, packet, &irp->IoStatus);
