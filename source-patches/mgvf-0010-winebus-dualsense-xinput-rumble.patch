+#include <string.h>
+
+/* psh_hid_macros.h pulls in hidusage.h, which spells its usage constants with
+ * USHORT. Inside wine that comes from windef.h, which this translation unit
+ * does not include and must not, because the host test compiles the same file
+ * on its own. It is unsigned short in both worlds. */
+typedef unsigned short USHORT;
+
+#include "psh_hid_macros.h"
+#include "dualsense_haptics.h"
+
+/* One waveform's collection. The shape is hid_device_add_haptics' template in
+ * hid.c, kept item for item so that anything wine's own xinput accepts from a
+ * pad winebus describes, it accepts from this one too. Both collections carry
+ * the same two report ids and differ only in the waveform the feature report
+ * names for each, which is how xinput tells them apart: it walks each Waveform
+ * List, reads the ordinal value out of the feature report, and calls that
+ * collection rumble or buzz accordingly.
+ *
+ * The Duration List and Cutoff Time are not optional decoration. xinput reads
+ * the waveform ordinal with HidP_GetUsageValue over the whole feature report,
+ * so every field the report declares must be there for the offsets to line up
+ * with what we answer in dualsense_haptics_feature_report. */
+static unsigned int haptics_collection(unsigned char *out, unsigned int out_size,
+                                       unsigned char feature_id, unsigned char output_id)
+{
+    const unsigned char template[] =
+    {
+        USAGE_PAGE(2, HID_USAGE_PAGE_HAPTICS),
+        USAGE(1, HID_USAGE_HAPTICS_SIMPLE_CONTROLLER),
+        COLLECTION(1, Logical),
+            REPORT_ID(1, feature_id),
+
+            USAGE(1, HID_USAGE_HAPTICS_WAVEFORM_LIST),
+            COLLECTION(1, NamedArray),
+                /* ordinal 1 and 2 are reserved for implicit waveforms */
+                USAGE(4, (HID_USAGE_PAGE_ORDINAL<<16)|3),
+                REPORT_SIZE(1, 16),
+                REPORT_COUNT(1, 1),
+                FEATURE(1, Data|Var|Abs|Null),
+            END_COLLECTION,
+
+            USAGE(1, HID_USAGE_HAPTICS_DURATION_LIST),
+            COLLECTION(1, NamedArray),
+                USAGE(4, (HID_USAGE_PAGE_ORDINAL<<16)|3),
+                REPORT_SIZE(1, 16),
+                REPORT_COUNT(1, 1),
+                FEATURE(1, Data|Var|Abs|Null),
+            END_COLLECTION,
+
+            USAGE(1, HID_USAGE_HAPTICS_WAVEFORM_CUTOFF_TIME),
+            UNIT(2, 0x1001), /* seconds */
+            UNIT_EXPONENT(1, -3), /* 10^-3 */
+            LOGICAL_MINIMUM(4, 0x00000000),
+            LOGICAL_MAXIMUM(4, 0x7fffffff),
+            REPORT_SIZE(1, 32),
+            REPORT_COUNT(1, 1),
+            FEATURE(1, Data|Var|Abs),
+            /* reset the globals this collection moved, so that the next one
+             * starts from the same state the pad's own descriptor left */
+            UNIT(1, 0),
+            UNIT_EXPONENT(1, 0),
+
+            REPORT_ID(1, output_id),
+            USAGE(1, HID_USAGE_HAPTICS_INTENSITY),
+            LOGICAL_MINIMUM(4, 0x00000000),
+            LOGICAL_MAXIMUM(4, 0x0000ffff),
+            REPORT_SIZE(1, 16),
+            REPORT_COUNT(1, 1),
+            OUTPUT(1, Data|Var|Abs),
+        END_COLLECTION,
+    };
+
+    if (out_size < sizeof(template)) return 0;
+    memcpy(out, template, sizeof(template));
+    return sizeof(template);
+}
+
+unsigned int dualsense_haptics_descriptor(unsigned char *out, unsigned int out_size,
+                                          unsigned char feature_id, unsigned char output_id)
+{
+    unsigned int written = 0, i, len;
+
+    for (i = 0; i < DUALSENSE_HAPTICS_WAVEFORMS; ++i)
+    {
+        if (!(len = haptics_collection(out + written, out_size - written, feature_id, output_id)))
+            return 0;
+        written += len;
+    }
+    return written;
+}
+
+/* The offset of the item that closes the descriptor's last top-level
+ * collection, which is where anything added to that collection has to go.
+ * Returns the length when there is no such item, which makes the caller
+ * refuse rather than write a descriptor that does not nest. */
+static unsigned int last_top_level_end(const unsigned char *desc, unsigned int len)
+{
+    unsigned int i = 0, depth = 0, close = len;
+
+    while (i < len)
+    {
+        unsigned char head = desc[i];
+        unsigned int size = head & 0x03;
+
+        if (size == 3) size = 4;
+        if ((head & 0xfc) == 0xa0) depth++;                 /* COLLECTION */
+        else if ((head & 0xfc) == 0xc0)                     /* END_COLLECTION */
+        {
+            if (!depth) return len;                         /* unbalanced */
+            if (--depth == 0) close = i;
+        }
+        i += 1 + size;
+    }
+    if (i != len || depth) return len;                      /* truncated or unbalanced */
+    return close;
+}
+
+/* The little device: one application collection with a token input report and
+ * the two haptics collections. Everything about it is the smallest thing that
+ * a client will still open and drive. */
+static unsigned int haptics_endpoint_head(unsigned char *out, unsigned int out_size,
+                                          unsigned char input_id)
+{
+    const unsigned char head[] =
+    {
+        USAGE_PAGE(1, HID_USAGE_PAGE_GENERIC),
+        /* A multi-axis controller, not a gamepad, and the difference is
+         * measured rather than aesthetic.
+         *
+         * xinput's try_add_device accepts a gamepad, a joystick OR a multi-axis
+         * controller, so any of the three would let it open this device. A game
+         * enumerating pads of its own looks for the first two: declared a
+         * gamepad, this device is counted as a second controller and given
+         * per-frame work it can never answer -- Beast lost half its frame rate
+         * to it, 2026-09-09. Declared a multi-axis controller it is invisible to
+         * that enumeration and unchanged to xinput. */
+        USAGE(1, HID_USAGE_GENERIC_MULTI_AXIS_CONTROLLER),
+        COLLECTION(1, Application),
+            REPORT_ID(1, input_id),
+            /* A byte of nothing, on the vendor page so that no client mistakes
+             * it for an axis: check_value_caps in xinput skips every usage that
+             * is not on the generic desktop page. It is here so the device has
+             * an input report to be read from at all. */
+            USAGE_PAGE(2, HID_USAGE_PAGE_VENDOR_DEFINED_BEGIN),
+            USAGE(1, 0x20),
+            LOGICAL_MINIMUM(1, 0),
+            LOGICAL_MAXIMUM(2, 0x00ff),
+            REPORT_SIZE(1, 8),
+            REPORT_COUNT(1, 1),
+            INPUT(1, Data|Var|Abs),
+            /* And one button that is never pressed, so that the button caps a
+             * client counts are not zero. A count of zero is not a fault in
+             * itself, but xinput allocates from it before it checks it. */
+            USAGE_PAGE(1, HID_USAGE_PAGE_BUTTON),
+            USAGE_MINIMUM(1, 1),
+            USAGE_MAXIMUM(1, 1),
+            LOGICAL_MINIMUM(1, 0),
+            LOGICAL_MAXIMUM(1, 1),
+            REPORT_SIZE(1, 1),
+            REPORT_COUNT(1, 1),
+            INPUT(1, Data|Var|Abs),
+            REPORT_SIZE(1, 7),
+            REPORT_COUNT(1, 1),
+            INPUT(1, Cnst|Var|Abs),
+    };
+
+    if (out_size < sizeof(head)) return 0;
+    memcpy(out, head, sizeof(head));
+    return sizeof(head);
+}
+
+unsigned int dualsense_haptics_endpoint(unsigned char *out, unsigned int out_size,
+                                        const unsigned char *desc, unsigned int len,
+                                        unsigned char feature_id, unsigned char output_id,
+                                        unsigned char input_id)
+{
+    const unsigned char tail[] = { END_COLLECTION };
+    unsigned char block[DUALSENSE_HAPTICS_DESC_MAX];
+    unsigned int head, body, total;
+
+    if (!(head = haptics_endpoint_head(block, sizeof(block), input_id))) return 0;
+    if (!(body = dualsense_haptics_descriptor(block + head, sizeof(block) - head, feature_id, output_id)))
+        return 0;
+    if (head + body + sizeof(tail) > sizeof(block)) return 0;
+    memcpy(block + head + body, tail, sizeof(tail));
+    total = head + body + sizeof(tail);
+
+    if (out_size < len + total) return 0;
+    memcpy(out, desc, len);
+    memcpy(out + len, block, total);
+    return len + total;
+}
+
+unsigned int dualsense_haptics_augment(unsigned char *out, unsigned int out_size,
+                                       const unsigned char *desc, unsigned int len,
+                                       unsigned char feature_id, unsigned char output_id)
+{
+    unsigned char block[DUALSENSE_HAPTICS_DESC_MAX];
+    unsigned int at = last_top_level_end(desc, len), size;
+
+    if (at >= len) return 0;
+    if (!(size = dualsense_haptics_descriptor(block, sizeof(block), feature_id, output_id))) return 0;
+    /* Built aside and measured before anything is written, so a buffer that is
+     * too small leaves the caller's exactly as it was. */
+    if (out_size < len + size) return 0;
+
+    memcpy(out, desc, at);
+    memcpy(out + at, block, size);
+    memcpy(out + at + size, desc + at, len - at);
+    return len + size;
+}
+
+/* The waveform ordinals xinput recognises. They are the values it compares the
+ * feature report against, not descriptor items, which is why they appear here
+ * and not in the collection above. */
+#define HAPTICS_WAVEFORM_BUZZ    0x1004
+#define HAPTICS_WAVEFORM_RUMBLE  0x1005
+
+static void put_u16(unsigned char *out, unsigned int value)
+{
+    out[0] = value & 0xff;
+    out[1] = (value >> 8) & 0xff;
+}
+
+static void put_u32(unsigned char *out, unsigned int value)
+{
+    put_u16(out, value & 0xffff);
+    put_u16(out + 2, value >> 16);
+}
+
+unsigned int dualsense_haptics_feature_report(unsigned char *out, unsigned int out_size,
+                                              unsigned char feature_id)
+{
+    /* Rumble first, buzz second, in the order the collections were written.
+     * Duration 0 means the waveform runs until it is changed -- the same
+     * answer winebus gives for its own pads, and the one xinput's contract
+     * wants, since a vibration set through XInputSetState stays set. */
+    static const unsigned int waveforms[DUALSENSE_HAPTICS_WAVEFORMS] =
+    {
+        HAPTICS_WAVEFORM_RUMBLE,
+        HAPTICS_WAVEFORM_BUZZ,
+    };
+    unsigned int i;
+
+    if (out_size < DUALSENSE_HAPTICS_FEATURE_LEN) return 0;
+    memset(out, 0, DUALSENSE_HAPTICS_FEATURE_LEN);
+    out[0] = feature_id;
+    for (i = 0; i < DUALSENSE_HAPTICS_WAVEFORMS; ++i)
+    {
+        unsigned char *entry = out + 1 + i * DUALSENSE_HAPTICS_WAVEFORM_ENTRY;
+        put_u16(entry, waveforms[i]);                   /* waveform  */
+        put_u16(entry + 2, 0);                          /* duration  */
+        put_u32(entry + 4, DUALSENSE_HAPTICS_CUTOFF_MS); /* cutoff   */
+    }
+    return DUALSENSE_HAPTICS_FEATURE_LEN;
+}
+
+/* MGVF mgvf-0010, second half: the Bluetooth input report, described.
+ *
+ * The middle of this is Sony's own declaration of report 0x01 on a cable, taken
+ * byte for byte out of the pad's USB report descriptor: six 8-bit axes, the
+ * vendor counter byte, the hat with its null state, fifteen buttons, thirteen
+ * more vendor bits, and then the rest of the report as a vendor block. It is
+ * copied rather than written because the pad is the authority on how its own
+ * bytes are laid out, and because the two reports carry the SAME payload -- the
+ * Bluetooth one simply puts one extra byte in front of it.
+ *
+ * So one byte of padding goes in front, and the trailing vendor block is
+ * widened by the difference: 63 bytes of USB payload become 77 of Bluetooth. */
+#define BT31_LEAD_PAD        1     /* the sequence/tag byte Bluetooth adds  */
+#define BT31_PAYLOAD         77    /* bytes after the report id             */
+#define BT31_NAMED           11    /* axes, counter, hat and buttons        */
+#define BT31_TRAILING_VENDOR (BT31_PAYLOAD - BT31_LEAD_PAD - BT31_NAMED)
+
+static const unsigned char bt31_fields[] =
+{
+    /* the byte Bluetooth puts in front, declared as vendor padding so that
+     * nothing tries to read it as an axis */
+    0x06, 0x00, 0xff,             /* USAGE_PAGE (vendor 0xff00)             */
+    0x09, 0x20,                   /* USAGE (0x20)                           */
+    0x75, 0x08,                   /* REPORT_SIZE (8)                        */
+    0x95, BT31_LEAD_PAD,          /* REPORT_COUNT (1)                       */
+    0x81, 0x02,                   /* INPUT (Data,Var,Abs)                   */
+
+    /* --- from here, Sony's own words for report 0x01 on a cable --- */
+    0x05, 0x01,                   /* USAGE_PAGE (Generic Desktop)           */
+    0x09, 0x30,                   /* USAGE (X)                              */
+    0x09, 0x31,                   /* USAGE (Y)                              */
+    0x09, 0x32,                   /* USAGE (Z)   -- the right stick, not a trigger */
+    0x09, 0x35,                   /* USAGE (Rz)  -- the right stick         */
+    0x09, 0x33,                   /* USAGE (Rx)  -- L2                      */
+    0x09, 0x34,                   /* USAGE (Ry)  -- R2                      */
+    0x15, 0x00,                   /* LOGICAL_MINIMUM (0)                    */
+    0x26, 0xff, 0x00,             /* LOGICAL_MAXIMUM (255)                  */
+    0x75, 0x08,                   /* REPORT_SIZE (8)                        */
+    0x95, 0x06,                   /* REPORT_COUNT (6)                       */
+    0x81, 0x02,                   /* INPUT (Data,Var,Abs)                   */
+    0x06, 0x00, 0xff,             /* USAGE_PAGE (vendor 0xff00)             */
+    0x09, 0x20,                   /* USAGE (0x20) -- the pad's own counter  */
+    0x95, 0x01,                   /* REPORT_COUNT (1)                       */
+    0x81, 0x02,                   /* INPUT (Data,Var,Abs)                   */
+    0x05, 0x01,                   /* USAGE_PAGE (Generic Desktop)           */
+    0x09, 0x39,                   /* USAGE (Hat switch)                     */
+    0x15, 0x00,                   /* LOGICAL_MINIMUM (0)                    */
+    0x25, 0x07,                   /* LOGICAL_MAXIMUM (7)                    */
+    0x35, 0x00,                   /* PHYSICAL_MINIMUM (0)                   */
+    0x46, 0x3b, 0x01,             /* PHYSICAL_MAXIMUM (315)                 */
+    0x65, 0x14,                   /* UNIT (degrees)                         */
+    0x75, 0x04,                   /* REPORT_SIZE (4)                        */
+    0x95, 0x01,                   /* REPORT_COUNT (1)                       */
+    0x81, 0x42,                   /* INPUT (Data,Var,Abs,Null)              */
+    0x65, 0x00,                   /* UNIT (None)                            */
+    0x05, 0x09,                   /* USAGE_PAGE (Button)                    */
+    0x19, 0x01,                   /* USAGE_MINIMUM (1)                      */
+    0x29, 0x0f,                   /* USAGE_MAXIMUM (15)                     */
+    0x15, 0x00,                   /* LOGICAL_MINIMUM (0)                    */
+    0x25, 0x01,                   /* LOGICAL_MAXIMUM (1)                    */
+    0x75, 0x01,                   /* REPORT_SIZE (1)                        */
+    0x95, 0x0f,                   /* REPORT_COUNT (15)                      */
+    0x81, 0x02,                   /* INPUT (Data,Var,Abs)                   */
+    0x06, 0x00, 0xff,             /* USAGE_PAGE (vendor 0xff00)             */
+    0x09, 0x21,                   /* USAGE (0x21)                           */
+    0x95, 0x0d,                   /* REPORT_COUNT (13 bits)                 */
+    0x81, 0x02,                   /* INPUT (Data,Var,Abs)                   */
+    /* --- end of Sony's own words --- */
+
+    /* the rest of the Bluetooth report, as one vendor block again, and the
+     * globals left as the descriptor had them so that whatever follows this
+     * report is declared against the same state as before */
+    0x06, 0x00, 0xff,             /* USAGE_PAGE (vendor 0xff00)             */
+    0x09, 0x22,                   /* USAGE (0x22)                           */
+    0x15, 0x00,                   /* LOGICAL_MINIMUM (0)                    */
+    0x26, 0xff, 0x00,             /* LOGICAL_MAXIMUM (255)                  */
+    0x75, 0x08,                   /* REPORT_SIZE (8)                        */
+    0x95, BT31_TRAILING_VENDOR,   /* REPORT_COUNT (65)                      */
+    0x81, 0x02,                   /* INPUT (Data,Var,Abs)                   */
+};
+
+/* The byte range of the input declaration of report `id`: from the USAGE that
+ * introduces it to the end of its INPUT item. Returns 0 when there is none. */
+static unsigned int bt_input_span(const unsigned char *desc, unsigned int len,
+                                  unsigned char id, unsigned int *start)
+{
+    unsigned int i = 0, usage_at = 0;
+    unsigned char report = 0;
+
+    while (i < len)
+    {
+        unsigned char head = desc[i];
+        unsigned int size = head & 0x03;
+
+        if (size == 3) size = 4;
+        if ((head & 0xfc) == 0x84)                             /* REPORT_ID    */
+        {
+            report = desc[i + 1];
+            usage_at = 0;
+        }
+        else if ((head & 0xfc) == 0x08) usage_at = i;          /* USAGE, local */
+        else if ((head & 0xfc) == 0x80)                        /* INPUT        */
+        {
+            if (report == id && usage_at) { *start = usage_at; return i + 1 + size - usage_at; }
+            usage_at = 0;
+        }
+        /* Any other main item consumes the local usages too, so a USAGE left
+         * over from an OUTPUT or a COLLECTION can never be mistaken for the one
+         * that introduces the input this is looking for. */
+        else if ((head & 0xfc) == 0x90 || (head & 0xfc) == 0xb0
+                 || (head & 0xfc) == 0xa0 || (head & 0xfc) == 0xc0) usage_at = 0;
+        i += 1 + size;
+    }
+    return 0;
+}
+
+static unsigned int splice(unsigned char *out, unsigned int out_size,
+                           const unsigned char *desc, unsigned int len,
+                           unsigned int at, unsigned int span,
+                           const unsigned char *block, unsigned int block_len)
+{
+    unsigned int grown = len - span + block_len;
+
+    if (out_size < grown) return 0;
+    memcpy(out, desc, at);
+    memcpy(out + at, block, block_len);
+    memcpy(out + at + block_len, desc + at + span, len - at - span);
+    return grown;
+}
+
+unsigned int dualsense_bt_input_describe(unsigned char *out, unsigned int out_size,
+                                         const unsigned char *desc, unsigned int len)
+{
+    unsigned char named[DUALSENSE_DESCRIPTOR_MAX];
+    unsigned int at = 0, span, grown;
+
+    if (!(span = bt_input_span(desc, len, DUALSENSE_BT_INPUT_REPORT_ID, &at))) return 0;
+    if (!(grown = splice(named, sizeof(named), desc, len, at, span, bt31_fields, sizeof(bt31_fields))))
+        return 0;
+
+    /* The short report keeps its own declaration, and that is deliberate.
+     *
+     * It was blanked here for a while: with 0x31 described, two reports claimed
+     * to carry the device's state and dinput said so -- "multiple device state
+     * reports found!" -- so silencing the one the pad supposedly stops sending
+     * looked like tidying up. It was not. Measured 2026-09-09: the pad does
+     * send 0x31, winebus processes 570 of them in twenty seconds, and what
+     * reaches the client is still a ten-byte 0x01. Declared opaque, that report
+     * is unreadable, and xinput failed to find every axis in it 255 times.
+     *
+     * Whatever decides which of the two a client is handed, it is not this
+     * descriptor, and taking the axes off a report that is still being
+     * delivered only makes it unreadable. The complaint from dinput is worth
+     * living with until that is understood. */
+    if (out_size < grown) return 0;
+    memcpy(out, named, grown);
+    return grown;
+}
+
+/* The pad's output report, as dualsense_usb.h documents it: byte 0 is the id,
+ * and the common block follows, with the two validity-flag bytes first and the
+ * motors right after them. Only the legacy-vibration bit is set: it is the one
+ * that drives the two rumble motors, which is all xinput asks for. */
+#define HAPTICS_OUT_FLAG0        1
+#define HAPTICS_OUT_FLAG1        2
+#define HAPTICS_OUT_MOTOR_RIGHT  3
+#define HAPTICS_OUT_MOTOR_LEFT   4
+/* Both bits, not just the first.
+ *
+ * 0x01 is the one that drives the two rumble motors the legacy way -- the
+ * mode the pad's owner measured as the strongest of the three on a six-pulse
+ * ladder, which is why mgvf-0009 exists. 0x02 is "disable audio haptics", and
+ * dualsense_usb.c records that SDL sets it on BOTH of its paths and that every
+ * one of the 6493 output reports in the measured session carried it. Sent
+ * without it, the request is accepted and nothing is felt: the pad has the
+ * effect but not through the motors. */
+#define HAPTICS_OUT_LEGACY_BIT   (0x01 | 0x02)
+
+/* A percentage over one motor byte, saturating rather than wrapping: asking for
+ * twice full power is asking for full power, not for none. */
+static unsigned char haptics_scale(unsigned int motor, unsigned int gain)
+{
+    unsigned int scaled;
+
+    if (gain == 100 || !motor) return (unsigned char)motor;
+    scaled = (motor * gain) / 100;
+    return (unsigned char)(scaled > 255 ? 255 : scaled);
+}
+
+unsigned int dualsense_haptics_motor_report(unsigned char *out, unsigned int out_size,
+                                            unsigned int length,
+                                            unsigned int rumble, unsigned int buzz,
+                                            unsigned int gain)
+{
+    if (length <= HAPTICS_OUT_MOTOR_LEFT) return 0;
+    if (out_size < length) return 0;
+
+    memset(out, 0, length);
+    out[0] = DUALSENSE_HAPTICS_MOTOR_REPORT_ID;
+    out[HAPTICS_OUT_FLAG0] = HAPTICS_OUT_LEGACY_BIT;
+    out[HAPTICS_OUT_FLAG1] = 0;
+    out[HAPTICS_OUT_MOTOR_RIGHT] = haptics_scale(buzz >> 8, gain);
+    out[HAPTICS_OUT_MOTOR_LEFT] = haptics_scale(rumble >> 8, gain);
+    return length;
+}
+
+int dualsense_haptics_output_levels(const unsigned char *report, unsigned int len,
+                                    unsigned char output_id,
+                                    unsigned int *rumble, unsigned int *buzz)
+{
+    if (len < DUALSENSE_HAPTICS_OUTPUT_LEN) return 0;
+    if (report[0] != output_id) return 0;
+
+    *rumble = report[1] | (report[2] << 8);
+    *buzz = report[3] | (report[4] << 8);
+    return 1;
+}
