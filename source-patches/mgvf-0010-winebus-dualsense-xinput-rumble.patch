+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINEBUS_DUALSENSE_HAPTICS_H
+#define __WINEBUS_DUALSENSE_HAPTICS_H
+
+/* The two report ids the collection uses. Report ids 3 and 4 are free on every
+ * DualSense descriptor we have captured -- the plain pad's USB one, and the
+ * Edge's over both transports -- but they are checked against the parsed
+ * descriptor at run time all the same, because a firmware revision could
+ * start using them and silently colliding would be worse than not offering
+ * haptics at all. */
+#define DUALSENSE_HAPTICS_OUTPUT_ID    0x03
+#define DUALSENSE_HAPTICS_FEATURE_ID   0x04
+
+/* The input report the little device declares so that a client has something to
+ * read from it. Free on every DualSense descriptor captured, like the two
+ * above, and checked against the real one all the same. */
+#define DUALSENSE_HAPTICS_INPUT_ID     0x06
+
+/* One waveform's entry in the feature report: which waveform this collection
+ * drives, how long it lasts, and how long the pad should keep going after the
+ * last write. Two of them, rumble then buzz, in the order the collections
+ * appear in the descriptor. */
+#define DUALSENSE_HAPTICS_WAVEFORM_ENTRY   8
+#define DUALSENSE_HAPTICS_WAVEFORMS        2
+#define DUALSENSE_HAPTICS_FEATURE_LEN      (1 + DUALSENSE_HAPTICS_WAVEFORMS * DUALSENSE_HAPTICS_WAVEFORM_ENTRY)
+
+/* The output report: one 16-bit intensity per collection, in the same order. */
+#define DUALSENSE_HAPTICS_OUTPUT_LEN       (1 + DUALSENSE_HAPTICS_WAVEFORMS * 2)
+
+/* The pad's own output report id -- the one the motors listen on, which is not
+ * the id the haptics collection declares. Spelled here rather than reached for
+ * from dualsense_usb.h so that this file stays compilable on its own. */
+#define DUALSENSE_HAPTICS_MOTOR_REPORT_ID  0x02
+
+/* The pad's Bluetooth input report -- the 78-byte one it sends once anything
+ * has read a feature report from it. Spelled here for the same reason as the
+ * line above. */
+#define DUALSENSE_BT_INPUT_REPORT_ID       0x31
+
+/* The length to build that output report with when the descriptor does not say.
+ * Over Bluetooth the pad declares no report 0x02 at all -- its outputs are 0x31
+ * and up -- and none is ever sent as such: the report is only what the
+ * translation packs into a 0x31. 48 is a plain DualSense's wired output report,
+ * which covers the whole common block. */
+#define DUALSENSE_HAPTICS_MOTOR_REPORT_LEN 48
+
+/* How long the pad keeps buzzing when nothing writes again. xinput's contract
+ * is that a set vibration persists until it is changed, so this is a safety
+ * net for a client that stops writing, not a duration. wine uses the same
+ * second in hid_device_add_haptics. */
+#define DUALSENSE_HAPTICS_CUTOFF_MS        1000
+
+/* The default shortest gap between two writes to the motors, in milliseconds.
+ * Eight is 125 a second, well past what the motors can follow; the value under
+ * the device's key overrides it, because how much a write costs depends on the
+ * link rather than on the pad. */
+#define DUALSENSE_HAPTICS_MIN_INTERVAL_MS  8
+
+/* An upper bound on what the collection adds to a descriptor, for the caller
+ * to size its buffer with. The real figure is returned by the builder. */
+#define DUALSENSE_HAPTICS_DESC_MAX         320
+
+/* An upper bound on a DualSense report descriptor after both operations, for a
+ * caller that wants one on the stack. The largest captured descriptor is 436
+ * bytes and this patch adds about a hundred. */
+#define DUALSENSE_DESCRIPTOR_MAX           1024
+
+/* Write the haptics collections on their own. Returns the number of bytes
+ * written, or 0 if they do not fit. */
+unsigned int dualsense_haptics_descriptor(unsigned char *out, unsigned int out_size,
+                                          unsigned char feature_id, unsigned char output_id);
+
+/* Write a copy of `desc` with a SECOND top-level collection after it, carrying
+ * the haptics and nothing else, and return the new length.
+ *
+ * A top level of its own, and that is the point. hidclass makes one device per
+ * top-level collection, so this produces two: the pad exactly as it was, which
+ * every client keeps reading as it always did, and beside it a small device
+ * that has motors and no axes.
+ *
+ * That separation is what stops a game being told the same thing twice. A game
+ * that reads the pad through raw HID for its glyphs and its adaptive triggers,
+ * and through XInput for rumble, would otherwise receive both -- and they do not
+ * merely duplicate, they fight: HID counts the Y axis downwards and XInput
+ * upwards, so the two cancel and the stick loses its vertical entirely while
+ * keeping its horizontal. Measured that way on 2026-09-09. With the motors on
+ * their own device, XInput has nothing to report but rumble.
+ *
+ * The little device still declares a two-byte input report. It carries nothing
+ * -- a vendor byte and one button that is never pressed -- and exists because a
+ * client opens a device and reads from it, and one with no input report at all
+ * is a device xinput drops before it ever looks for the motors.
+ */
+unsigned int dualsense_haptics_endpoint(unsigned char *out, unsigned int out_size,
+                                        const unsigned char *desc, unsigned int len,
+                                        unsigned char feature_id, unsigned char output_id,
+                                        unsigned char input_id);
+
+/* Write a copy of `desc` with the haptics collections INSIDE its last top-level
+ * collection, and return the new length, or 0 if the descriptor does not end in
+ * a top-level collection or the result does not fit.
+ *
+ * Inside, not after, and the difference is the whole feature. hidclass creates
+ * one device per TOP-LEVEL collection: a haptics collection written after the
+ * pad's would become a second device, carrying the motors and no axes, while
+ * the device carrying the axes carried no motors -- and xinput needs both on
+ * the one device it opens. Written inside, the pad still presents exactly one
+ * top-level collection, with two more logical collections in it. */
+unsigned int dualsense_haptics_augment(unsigned char *out, unsigned int out_size,
+                                       const unsigned char *desc, unsigned int len,
+                                       unsigned char feature_id, unsigned char output_id);
+
+/* Fill the feature report that says which waveform each collection drives.
+ * This is what xinput reads to decide that one collection is the rumble motor
+ * and the other the buzz motor. Returns the length written, or 0. */
+unsigned int dualsense_haptics_feature_report(unsigned char *out, unsigned int out_size,
+                                              unsigned char feature_id);
+
+/* Build the output report that moves the pad's two motors, in the USB shape --
+ * id 0x02, the 47-byte common block after it -- of `length` bytes. That shape
+ * is the one the rest of this driver already knows how to deliver: on a cable
+ * it goes to the pad as it is, and over Bluetooth mgvf-0005's translation packs
+ * it into a 0x31 and signs it.
+ *
+ * The intensities are xinput's, 0..65535, and the pad's motors take a byte
+ * each, so they are scaled down rather than clamped -- an intensity of 300
+ * must not arrive as full power. xinput's rumble is the low-frequency motor,
+ * which is the pad's LEFT, and its buzz the high-frequency one, the RIGHT.
+ *
+ * `gain` is a percentage over the two motor bytes, saturating at full power:
+ * 100 leaves them alone, 0 silences them. It is here because the preference the
+ * owner sets applies to what a game asks for, and until now it could not: the
+ * options mgvf-0009 reads are only read for a pad on Bluetooth, because that is
+ * the only transport whose packets it rewrites. This report is made rather than
+ * rewritten, and is made on both transports, so the preference can be honoured
+ * on both -- which matters, because the same game's rumble is noticeably milder
+ * on a cable than over the air.
+ *
+ * Returns the length written, or 0 if it does not fit. */
+unsigned int dualsense_haptics_motor_report(unsigned char *out, unsigned int out_size,
+                                            unsigned int length,
+                                            unsigned int rumble, unsigned int buzz,
+                                            unsigned int gain);
+
+/* MGVF mgvf-0010, second half: describe the fields of the pad's Bluetooth input report.
+ *
+ * Over Bluetooth a DualSense sends report 0x31, and its own descriptor declares
+ * all 77 bytes of it as one vendor-defined block: not an axis, not a button,
+ * nothing HidP can read. The 9-byte report 0x01 that does declare axes is the
+ * short one the pad stops sending the moment anything reads a feature report,
+ * which everything does. So over Bluetooth xinput -- and dinput, and anything
+ * else that goes through HidP -- cannot read the pad's state at all.
+ *
+ * The fields are there; only the declaration is missing. This replaces that one
+ * opaque block with the declaration Sony itself writes for the SAME CONTENT
+ * over USB, copied item for item from the pad's own USB descriptor, with one
+ * byte of padding in front for the sequence byte Bluetooth adds and the
+ * trailing vendor block widened to match. Every byte of the report keeps its
+ * place; what changes is that the first eleven are now named.
+ *
+ * Returns the new length, or 0 when the descriptor has no such report, which is
+ * every pad on a cable and every device that is not a DualSense.
+ */
+unsigned int dualsense_bt_input_describe(unsigned char *out, unsigned int out_size,
+                                         const unsigned char *desc, unsigned int len);
+
+/* Read the two intensities out of an output report written by a client.
+ * Returns 0 when the report is not the haptics one, so a caller can pass every
+ * write through this and act only on the ones that are. The intensities are
+ * 0..65535, the range the descriptor declares and xinput scales its own
+ * 0..65535 vibration into unchanged. */
+int dualsense_haptics_output_levels(const unsigned char *report, unsigned int len,
+                                    unsigned char output_id,
+                                    unsigned int *rumble, unsigned int *buzz);
+
