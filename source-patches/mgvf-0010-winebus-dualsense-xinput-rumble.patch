+/* MGVF mgvf-0010: give a DualSense the haptics collection wine's own xinput
+ * looks for, WITHOUT taking anything away from it.
+ *
+ * A game that reads XInput gets no vibration from a DualSense under wine.
+ * xinput1_3 drives a pad through a HID haptics collection (usage page 0x0E)
+ * and nothing else, and no descriptor Sony ships has one. wine can build that
+ * collection -- hid_device_add_haptics does it for every pad winebus describes
+ * itself -- but a DualSense is not one of those: it arrives with its own
+ * descriptor, which is exactly what makes the adaptive triggers, the touchpad
+ * and Sony's own library work. Replacing it is what the SDL bus does, and the
+ * price is all three.
+ *
+ * So the collection is APPENDED. The pad's descriptor is left byte for byte as
+ * it was and two collections are added after it, rumble and buzz, sharing one
+ * new feature id and one new output id. Both new reports are far shorter than
+ * what the pad already declares, so the three report lengths libScePad gates on
+ * do not move -- asserted for all three captured descriptors by
+ * dualsense-descriptors/haptics_augment.py, which parses the bytes this build
+ * really produces.
+ *
+ * Off unless the device's key says XInputRumble, and it is read here rather
+ * than at driver start because, like UsbEmulation, it is wanted per device as
+ * the device arrives.
+ *
+ * Called after dualsense_usb_replace_descriptors, so that when the USB
+ * emulation is on the collection lands on the descriptor being presented
+ * rather than on the one it replaced. */
+static NTSTATUS dualsense_haptics_add_descriptor(DEVICE_OBJECT *device)
+{
+    struct device_extension *ext = (struct device_extension *)device->DeviceExtension;
+    unsigned char described[DUALSENSE_DESCRIPTOR_MAX];
+    HIDP_DEVICE_DESC collection_desc;
+    const unsigned char *source;
+    unsigned int source_length, length;
+    NTSTATUS status;
+    ULONG i;
+    BYTE *copy;
+
+    if (!is_dualsense_gamepad(ext->desc.vid, ext->desc.pid)) return STATUS_SUCCESS;
+    if (!get_device_option(ext->desc.vid, ext->desc.pid, L"XInputRumble", 0)) return STATUS_SUCCESS;
+
+    /* Two ids are needed that the pad does not already use. They are free on
+     * every descriptor we have captured, but a firmware revision could start
+     * using them, and colliding silently would be worse than offering nothing:
+     * a client would then write intensities into one of the pad's own reports. */
+    for (i = 0; i < ext->collection_desc.ReportIDsLength; ++i)
+    {
+        BYTE id = ext->collection_desc.ReportIDs[i].ReportID;
+        if (id != DUALSENSE_HAPTICS_FEATURE_ID && id != DUALSENSE_HAPTICS_OUTPUT_ID) continue;
+        WARN("device %p: report id %#x is already used by %04x:%04x, no haptics offered\n",
+             device, id, ext->desc.vid, ext->desc.pid);
+        return STATUS_SUCCESS;
+    }
+
+    source = ext->report_desc;
+    source_length = ext->report_desc_length;
+
+    /* MGVF mgvf-0010, second half: on Bluetooth, name the fields of the report the pad
+     * actually sends, before anything else is done to the descriptor.
+     *
+     * Without this the rest is decoration over there: the pad's 0x31 is one
+     * opaque vendor block, so xinput finds the motors, writes to them, and
+     * still cannot read a single axis or button -- which a game feels as a
+     * stick jammed in a corner. Left alone on a cable, where the pad's own
+     * report 0x01 already declares everything. */
+    if (ext->desc.bus_type == BUS_TYPE_BLUETOOTH)
+    {
+        unsigned int named = dualsense_bt_input_describe(described, sizeof(described),
+                                                         source, source_length);
+        if (!named)
+            WARN("device %p: no Bluetooth input report %#x to name in the descriptor of %04x:%04x\n",
+                 device, DUALSENSE_BT_INPUT_REPORT_ID, ext->desc.vid, ext->desc.pid);
+        else
+        {
+            TRACE("device %p: named the fields of Bluetooth input report %#x, %u descriptor bytes become %u\n",
+                  device, DUALSENSE_BT_INPUT_REPORT_ID, source_length, named);
+            source = described;
+            source_length = named;
+        }
+    }
+
+    length = source_length + DUALSENSE_HAPTICS_DESC_MAX;
+    if (!(copy = RtlAllocateHeap(GetProcessHeap(), 0, length))) return STATUS_NO_MEMORY;
+
+    /* Inside the pad's own top-level collection, not after it: hidclass makes
+     * one device per top-level collection, so a haptics collection written
+     * after this one would arrive as a second device with the motors and no
+     * axes, and leave the axes on a device with no motors. */
+    if (!(length = dualsense_haptics_augment(copy, length, source, source_length,
+                                             DUALSENSE_HAPTICS_FEATURE_ID, DUALSENSE_HAPTICS_OUTPUT_ID)))
+    {
+        WARN("device %p: the descriptor of %04x:%04x does not end in a top-level collection, "
+             "no haptics offered\n", device, ext->desc.vid, ext->desc.pid);
+        RtlFreeHeap(GetProcessHeap(), 0, copy);
+        return STATUS_SUCCESS;
+    }
+
+    status = HidP_GetCollectionDescription(copy, length, PagedPool, &collection_desc);
+    if (status != HIDP_STATUS_SUCCESS)
+    {
+        /* Nothing is swapped unless the grown descriptor parses. The pad keeps
+         * the descriptor it came with and loses only the haptics. */
+        ERR("device %p: the descriptor of %04x:%04x does not parse with the haptics collection, status %#lx\n",
+            device, ext->desc.vid, ext->desc.pid, status);
+        RtlFreeHeap(GetProcessHeap(), 0, copy);
+        return STATUS_SUCCESS;
+    }
+
+    TRACE("device %p: %04x:%04x keeps its %u-byte descriptor and grows to %u with haptics, "
+          "feature %#x, output %#x\n", device, ext->desc.vid, ext->desc.pid,
+          ext->report_desc_length, length,
+          DUALSENSE_HAPTICS_FEATURE_ID, DUALSENSE_HAPTICS_OUTPUT_ID);
+
     HidP_FreeCollectionDescription(&ext->collection_desc);
     RtlFreeHeap(GetProcessHeap(), 0, ext->report_desc);
     ext->report_desc = copy;
     ext->report_desc_length = length;
     ext->collection_desc = collection_desc;
+    ext->haptics_feature_id = DUALSENSE_HAPTICS_FEATURE_ID;
+    ext->haptics_output_id = DUALSENSE_HAPTICS_OUTPUT_ID;
     return STATUS_SUCCESS;
 }
 
