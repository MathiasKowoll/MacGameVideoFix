--- a/dlls/winebus.sys/bus_iohid.c
+++ b/dlls/winebus.sys/bus_iohid.c
@@ -445,17 +445,32 @@
  * a registry value says so:
  *
  *   HKLM\System\CurrentControlSet\Services\winebus\Devices\<vid>/<pid>
- *     SeizeDevice  REG_DWORD  absent: the default above. 0: open shared, as
- *                             before. Non-zero: seize.
+ *     SeizeDevice  REG_DWORD  absent: open shared (mgvf-0034). 0: open shared.
+ *                             Non-zero: seize.
  *
- * Unlike mgvf-0005's UsbEmulation this one is ON by default for the pads it
- * covers, because it was written against the drops seen under a shared open
- * on 2026-09-08. That it prevents them is not measured; under the seize no
- * kIOReturnTimeout was logged in the seven disconnect windows checked. The
- * value is there for the two people the default is wrong for -- a DualSense
- * owner who would rather share the pad with macOS, and the owner of some
- * other pad who has measured the same timeouts and wants to try it.
+ * MGVF mgvf-0034: the default is SHARED for every pad, a DualSense on
+ * Bluetooth included, and only a non-zero SeizeDevice seizes. From mgvf-0006
+ * until 2026-09-15 the seize was on by default for the pads above, written
+ * against the drops seen under a shared open on 2026-09-08; that it prevented
+ * them was never measured. What was measured with SeizeDevice 0 on a DualSense
+ * Edge over Bluetooth, on 2026-09-14 and 2026-09-15:
  *
+ *   - three sessions of play (8, 25 and 34 minutes) with no "Unable to send",
+ *     no "exclusive access" and no idle cut during play;
+ *   - a 24-hour Bluetooth log in which each of seven disconnects had a cause:
+ *     four followed a power-off request, three were macOS's idle cut, all
+ *     three after play had ended -- so a session left behind does not keep
+ *     the pad awake;
+ *   - by the user, in the 34-minute session: the PS button, the lights and
+ *     the rumble working.
+ *
+ * The seize's own costs are measured above: the idle cut in the middle of a
+ * game, and a pad macOS cannot use while a bottle holds it. Sharing has one
+ * measured cost of its own, answered in mgvf-0035: macOS repaints the lightbar
+ * whenever the front application changes. And mgvf-0033's power-off acts only
+ * on a seized pad, so by default it no longer acts; macOS's idle cut is what
+ * turns off a shared pad nobody is using.
+ *
  * The value cannot reach a keyboard or a mouse: the enumeration below refuses
  * everything that is not a joystick or a gamepad before it ever opens
  * anything, so the widest this can be turned on for is a game controller.
@@ -463,9 +478,8 @@
 static BOOL want_seize(const struct device_desc *desc)
 {
     const struct device_options *device;
-    BOOL seize;
-
-    seize = desc->bus_type == BUS_TYPE_BLUETOOTH && is_dualsense_gamepad(desc->vid, desc->pid);
+    /* MGVF mgvf-0034: nothing is seized unless its key asks, see above */
+    BOOL seize = FALSE;
 
     /* The per-device options the PE side read at driver start, handed to this
      * bus in bus_options at init. An entry with no SeizeDevice value leaves
@@ -697,6 +711,11 @@
         ERR("Failed to open HID device %p (vid %04x, pid %04x)\n", IOHIDDevice, desc.vid, desc.pid);
         return;
     }
+    /* MGVF mgvf-0034: the counterpart of the seize's line, so a trace says
+     * which open a pad got; RaccoonBot also asks this string whether an engine
+     * shares by default. */
+    if (!open_options)
+        TRACE("Opened HID device %p (vid %04x, pid %04x) shared with macOS\n", IOHIDDevice, desc.vid, desc.pid);
     IOHIDDeviceScheduleWithRunLoop(IOHIDDevice, CFRunLoopGetCurrent(), kCFRunLoopDefaultMode);
 
     str = IOHIDDeviceGetProperty(IOHIDDevice, CFSTR(kIOHIDManufacturerKey));
