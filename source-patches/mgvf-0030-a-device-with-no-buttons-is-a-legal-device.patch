-     * from the button-cap count before it checks it. 0 is the experiment:
-     * Ghost of Tsushima does not keep L3 held while XInputRumble is on, and a
-     * device reporting every button released on every poll is the candidate. */
+    /* MGVF mgvf-0029, and mgvf-0030 turned it around: the device declares NO
+     * button now, and XInputRumbleStubButton 1 puts the old one back.
+     *
+     * The button was there so that a client counting button caps would not see
+     * zero, because xinput allocated from that count before it checked it. That
+     * was a real hazard and it is now fixed at its own end (mgvf-0030), and it
+     * was only ever OUR xinput that could hit it: since mgvf-0028 this device
+     * is published under the xinput interface and no other, so the only code
+     * that opens it is code this set ships.
+     *
+     * And the button had a cost that was measured rather than guessed. Ghost of
+     * Tsushima would not keep L3 held while XInputRumble was on: a device
+     * reporting every button released on every poll is the shape of a held
+     * button being cleared, and with the button gone L3 holds. Confirmed by the
+     * hand on the pad, 2026-09-12. */
     {
         unsigned int with_button = get_device_option(ext->desc.vid, ext->desc.pid,
-                                                     L"XInputRumbleStubButton", 1);
-        if (!with_button)
-            TRACE("device %p: the haptics device declares no button -- the experiment for a game that"
-                  " loses a held button with the motors offered to xinput\n", device);
+                                                     L"XInputRumbleStubButton", 0);
+        if (with_button)
+            TRACE("device %p: the haptics device declares the never-pressed button again -- a game that"
+                  " reads it may stop holding a button down\n", device);
         length = dualsense_haptics_endpoint(copy, length, source, source_length,
                                             DUALSENSE_HAPTICS_FEATURE_ID, DUALSENSE_HAPTICS_OUTPUT_ID,
                                             DUALSENSE_HAPTICS_INPUT_ID, with_button != 0);
